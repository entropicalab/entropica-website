---
// interactive hour-by-hour comfort heatmap for simulation studies.
// draws 8,760 hours of two cases (e.g. as built / with the parasol) from a
// compact json (see posters/web-data/*_json.py in each project folder):
//   { hours, outdoor[], cases: { base|design: { operative[], target[],
//     fromTarget[], comfortable: "0101…" } } }   temperatures in tenths of °C
// three views: what changed (default), case a, case b. hover any hour for
// both cases; hover the margin bars for totals by hour of day and by month.
// all labels are html, so they're searchable and restylable.
import type { Locale } from '../i18n/strings';

interface Props {
  src: string;
  cases: [string, string];
  alt: string;
  fallback: string; // poster image, shown if js is off
  locale: Locale;
}
const { src, cases, alt, fallback, locale } = Astro.props;

const L = {
  en: {
    changed: 'what changed',
    months: ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'],
    byHour: 'by hour of day',
    byMonth: 'by month',
    legendChanged: ['became comfortable', 'became too cool', 'became too warm', 'unchanged: comfortable', 'unchanged: too warm', 'unchanged: too cool'],
    legendCase: 'degrees from the comfort target (°C). sand = comfortable',
    loading: 'loading 8,760 hours…',
  },
  es: {
    changed: 'qué cambió',
    months: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
    byHour: 'por hora del día',
    byMonth: 'por mes',
    legendChanged: ['pasó a confort', 'pasó a demasiado frío', 'pasó a demasiado calor', 'sin cambio: en confort', 'sin cambio: demasiado calor', 'sin cambio: demasiado frío'],
    legendCase: 'grados respecto al objetivo de confort (°C). arena = confort',
    loading: 'cargando 8,760 horas…',
  },
}[locale];

const CHANGED = ['#fab31e', '#5a98a0', '#c8714f', '#e9e3d6', '#ecd3c4', '#d2e2e1'];
const BINS = ['#014555', '#236e7d', '#5a98a0', '#96c1c3', '#e3ddd0', '#deab8a', '#c8714f', '#a0422d', '#6b1e1b'];
const BIN_TICKS = ['−10', '−6', '−4', '−2.5', '2.5', '4', '6', '10'];
---

<figure class="cmap" data-src={src} data-locale={locale} data-cases={JSON.stringify(cases)}>
  <div class="cmap-bar">
    <div class="cmap-views" role="group">
      <button type="button" data-view="changed" aria-pressed="true">{L.changed}</button>
      <button type="button" data-view="base" aria-pressed="false">{cases[0]}</button>
      <button type="button" data-view="design" aria-pressed="false">{cases[1]}</button>
    </div>
    <div class="cmap-stat" aria-live="polite">
      <span class="cmap-stat-big"></span>
      <span class="cmap-stat-sub">{L.loading}</span>
    </div>
  </div>

  <div class="cmap-grid">
    <div class="cmap-months-label">{L.byMonth}</div>
    <div class="cmap-months" aria-hidden="true"></div>
    <div></div>

    <div class="cmap-yaxis" aria-hidden="true"><span>24h</span><span>18h</span><span>12h</span><span>6h</span><span>0h</span></div>
    <div class="cmap-plot">
      <canvas role="img" aria-label={alt}></canvas>
      <div class="cmap-cursor" hidden></div>
    </div>
    <div class="cmap-hours" aria-hidden="true"></div>

    <div></div>
    <div class="cmap-xaxis" aria-hidden="true">{L.months.map((m) => <span>{m}</span>)}</div>
    <div class="cmap-hours-label">{L.byHour}</div>
  </div>

  <div class="cmap-legend" data-legend="changed">
    {L.legendChanged.map((l, i) => (
      <span class="lg-item"><i style={`background:${CHANGED[i]}`}></i>{l}</span>
    ))}
  </div>
  <div class="cmap-legend" data-legend="case" hidden>
    <div class="lg-title">{L.legendCase}</div>
    <div class="lg-scale">{BINS.map((c) => <i style={`background:${c}`}></i>)}</div>
    <div class="lg-ticks">{BIN_TICKS.map((t) => <span>{t}</span>)}</div>
  </div>

  <div class="cmap-tip" hidden></div>
  <noscript><img src={fallback} alt={alt} width="2160" height="2200" style="width:100%;height:auto" /></noscript>
</figure>

<style>
  .cmap { margin: 0; position: relative; }
  .cmap :global(*) { text-transform: none; }

  .cmap-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px; margin-bottom: 20px; }
  .cmap-views { display: inline-flex; border: 1px solid var(--line-on-paper); }
  .cmap-views button {
    font: inherit;
    font-size: 13px;
    padding: 8px 14px;
    background: transparent;
    color: var(--mute-on-paper);
    border: 0;
    border-left: 1px solid var(--line-on-paper);
    cursor: pointer;
  }
  .cmap-views button:first-child { border-left: 0; }
  .cmap-views button:hover { color: var(--ink-on-paper); }
  .cmap-views button[aria-pressed='true'] { background: var(--ink-on-paper); color: var(--paper); }
  .cmap-stat { text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .cmap-stat-big { font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em; font-feature-settings: 'tnum' 1; }
  .cmap-stat-sub { font-size: 13px; color: var(--mute-on-paper); max-width: 46ch; }

  .cmap-grid {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 72px;
    column-gap: 10px;
    row-gap: 6px;
  }
  .cmap-yaxis {
    display: flex; flex-direction: column; justify-content: space-between;
    font-size: 11px; color: var(--mute-on-paper-2); text-align: right; font-feature-settings: 'tnum' 1;
  }
  .cmap-yaxis span { line-height: 1; transform: translateY(-1px); }
  .cmap-plot { position: relative; height: clamp(170px, 24vw, 280px); cursor: crosshair; }
  .cmap-plot canvas { display: block; width: 100%; height: 100%; }
  .cmap-cursor { position: absolute; pointer-events: none; outline: 1.5px solid var(--ink-on-paper); outline-offset: 0; }
  .cmap-xaxis { display: grid; grid-template-columns: repeat(12, 1fr); font-size: 11px; color: var(--mute-on-paper-2); }
  .cmap-hours, .cmap-months { position: relative; }
  .cmap-hours-label, .cmap-months-label { font-size: 10px; letter-spacing: 0.08em; color: var(--mute-on-paper-2); line-height: 1.3; }
  .cmap-months-label { text-align: right; align-self: end; }
  .cmap-months { height: 56px; }
  .cmap-hours :global(svg), .cmap-months :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cmap-hours :global(rect), .cmap-months :global(rect) { cursor: default; }
  .cmap-hours :global(rect:hover), .cmap-months :global(rect:hover) { opacity: 0.7; }

  .cmap-legend { margin-top: 18px; font-size: 12px; color: var(--mute-on-paper); }
  .cmap-legend[data-legend='changed'] { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .cmap-legend[hidden] { display: none; }
  .lg-item { display: inline-flex; align-items: center; gap: 8px; }
  .lg-item i, .lg-scale i { display: inline-block; height: 12px; }
  .lg-item i { width: 18px; }
  .lg-title { margin-bottom: 8px; }
  .lg-scale { display: grid; grid-template-columns: repeat(9, 1fr); gap: 2px; max-width: 560px; }
  .lg-scale i { width: 100%; }
  .lg-ticks { display: grid; grid-template-columns: 0.5fr repeat(8, 1fr) 0.5fr; max-width: 560px; margin-top: 4px; font-size: 11px; font-feature-settings: 'tnum' 1; }
  .lg-ticks span { text-align: center; }
  .lg-ticks span:first-child { grid-column: 2; }

  .cmap-tip {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    background: var(--paper);
    border: 1px solid var(--ink-on-paper);
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
    min-width: 220px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .cmap-tip[hidden] { display: none; }
  .cmap-tip :global(.t-when) { font-size: 13px; color: var(--ink-on-paper); margin-bottom: 4px; }
  .cmap-tip :global(.t-row) { display: flex; justify-content: space-between; gap: 16px; color: var(--mute-on-paper); }
  .cmap-tip :global(.t-row b) { color: var(--ink-on-paper); font-weight: 500; font-feature-settings: 'tnum' 1; white-space: nowrap; }
  .cmap-tip :global(.t-case) { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line-on-paper-2); }
  .cmap-tip :global(.t-state) { display: inline-flex; align-items: center; gap: 6px; }
  .cmap-tip :global(.t-state i) { width: 9px; height: 9px; display: inline-block; }

  @media (max-width: 640px) {
    .cmap-bar { flex-direction: column; align-items: stretch; }
    .cmap-stat { text-align: left; }
    .cmap-grid { grid-template-columns: 30px minmax(0, 1fr) 44px; column-gap: 6px; }
    .cmap-xaxis span:nth-child(even) { visibility: hidden; }
    .cmap-hours-label, .cmap-months-label { font-size: 9px; }
  }
</style>

<script>
  type Case = { operative: number[]; target: number[]; fromTarget: number[]; comfortable: string };
  type Data = { hours: number; outdoor: number[]; cases: { base: Case; design: Case } };
  type View = 'changed' | 'base' | 'design';
  type State = 'ok' | 'hot' | 'cold';

  const CHANGED = ['#fab31e', '#5a98a0', '#c8714f', '#e9e3d6', '#ecd3c4', '#d2e2e1'];
  const BINS = ['#014555', '#236e7d', '#5a98a0', '#96c1c3', '#e3ddd0', '#deab8a', '#c8714f', '#a0422d', '#6b1e1b'];
  const EDGES = [-10, -6, -4, -2.5, 2.5, 4, 6, 10];
  const MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

  const T = {
    en: {
      months: ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'],
      // hour h is the hour ending at h:00, so h=15 reads "2–3 pm", h=12 "11 am–12 pm"
      hourSpan: (h: number) => {
        const f = (x: number): [number, string] => [x % 12 === 0 ? 12 : x % 12, x % 24 < 12 ? 'am' : 'pm'];
        const [s, sp] = f(h - 1), [e, ep] = f(h);
        return sp === ep ? `${s}–${e} ${ep}` : `${s} ${sp}–${e} ${ep}`;
      },
      outdoor: 'outdoors',
      fromTarget: 'from target',
      state: { ok: 'comfortable', hot: 'too warm', cold: 'too cool' } as Record<State, string>,
      statChanged: (net: number) => `${net >= 0 ? '+' : '−'}${Math.abs(net).toLocaleString('en-US')} comfortable hours a year`,
      subChanged: (gained: number, lost: number) => `${gained.toLocaleString('en-US')} hours become comfortable, ${lost.toLocaleString('en-US')} stop being comfortable.`,
      statCase: (n: number) => `${n.toLocaleString('en-US')} comfortable hours a year`,
      subCase: (pct: number) => `${pct}% of the year, no air-conditioning.`,
      tipHourNet: (h: string, v: number) => `${h}: ${v >= 0 ? '+' : '−'}${Math.abs(v)} comfortable hours over the year`,
      tipHourCase: (h: string, v: number) => `${h}: comfortable on ${v} of 365 days`,
      tipMonthNet: (m: string, v: number) => `${m}: ${v >= 0 ? '+' : '−'}${Math.abs(v)} comfortable hours`,
      tipMonthCase: (m: string, v: number, of: number) => `${m}: ${v} of ${of} hours comfortable`,
    },
    es: {
      months: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
      hourSpan: (h: number) => `${h - 1}–${h} h`,
      outdoor: 'exterior',
      fromTarget: 'del objetivo',
      state: { ok: 'en confort', hot: 'demasiado calor', cold: 'demasiado frío' } as Record<State, string>,
      statChanged: (net: number) => `${net >= 0 ? '+' : '−'}${Math.abs(net).toLocaleString('en-US')} horas en confort al año`,
      subChanged: (gained: number, lost: number) => `${gained.toLocaleString('en-US')} horas pasan a confort y ${lost.toLocaleString('en-US')} dejan de estarlo.`,
      statCase: (n: number) => `${n.toLocaleString('en-US')} horas en confort al año`,
      subCase: (pct: number) => `${pct}% del año, sin aire acondicionado.`,
      tipHourNet: (h: string, v: number) => `${h}: ${v >= 0 ? '+' : '−'}${Math.abs(v)} horas en confort en el año`,
      tipHourCase: (h: string, v: number) => `${h}: en confort ${v} de 365 días`,
      tipMonthNet: (m: string, v: number) => `${m}: ${v >= 0 ? '+' : '−'}${Math.abs(v)} horas en confort`,
      tipMonthCase: (m: string, v: number, of: number) => `${m}: ${v} de ${of} horas en confort`,
    },
  };

  const deg = (tenths: number) => `${(tenths / 10).toFixed(1)} °C`;
  const signed = (tenths: number) => `${tenths > 0 ? '+' : tenths < 0 ? '−' : '±'}${Math.abs(tenths / 10).toFixed(1)} °C`;

  function stateOf(c: Case, i: number): State {
    return c.comfortable[i] === '1' ? 'ok' : c.fromTarget[i] > 0 ? 'hot' : 'cold';
  }
  function binColor(c: Case, i: number): string {
    if (c.comfortable[i] === '1') return BINS[4];
    const v = c.fromTarget[i] / 10;
    if (v > 0) return BINS[v < EDGES[5] ? 5 : v < EDGES[6] ? 6 : v < EDGES[7] ? 7 : 8];
    return BINS[v >= EDGES[3] ? 3 : v >= EDGES[2] ? 3 : v >= EDGES[1] ? 2 : v >= EDGES[0] ? 1 : 0];
  }
  function changedIndex(a: State, b: State): number {
    if (a === b) return a === 'ok' ? 3 : a === 'hot' ? 4 : 5;
    return b === 'ok' ? 0 : b === 'cold' ? 1 : 2;
  }
  const svgNS = 'http://www.w3.org/2000/svg';
  function rect(x: number, y: number, w: number, h: number, fill: string, tip: string): SVGRectElement {
    const r = document.createElementNS(svgNS, 'rect');
    r.setAttribute('x', String(x)); r.setAttribute('y', String(y));
    r.setAttribute('width', String(Math.max(0, w))); r.setAttribute('height', String(Math.max(0, h)));
    r.setAttribute('fill', fill); r.dataset.tip = tip;
    return r;
  }

  function init(fig: HTMLElement) {
    const locale = (fig.dataset.locale === 'es' ? 'es' : 'en') as 'en' | 'es';
    const t = T[locale];
    const caseNames = JSON.parse(fig.dataset.cases ?? '["a","b"]') as [string, string];
    const canvas = fig.querySelector('canvas') as HTMLCanvasElement;
    const plot = fig.querySelector('.cmap-plot') as HTMLElement;
    const cursor = fig.querySelector('.cmap-cursor') as HTMLElement;
    const tip = fig.querySelector('.cmap-tip') as HTMLElement;
    const big = fig.querySelector('.cmap-stat-big') as HTMLElement;
    const sub = fig.querySelector('.cmap-stat-sub') as HTMLElement;
    const hoursBox = fig.querySelector('.cmap-hours') as HTMLElement;
    const monthsBox = fig.querySelector('.cmap-months') as HTMLElement;
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('.cmap-views button')];
    const legends = [...fig.querySelectorAll<HTMLElement>('.cmap-legend')];

    let data: Data | null = null;
    let view: View = 'changed';
    const days = 365;

    function dayLabel(d: number): string {
      let m = 0, rest = d;
      while (rest >= MONTH_DAYS[m]) { rest -= MONTH_DAYS[m]; m++; }
      return `${rest + 1} ${t.months[m]}`;
    }

    function colorAt(i: number): string {
      const { base, design } = data!.cases;
      if (view === 'changed') return CHANGED[changedIndex(stateOf(base, i), stateOf(design, i))];
      return binColor(view === 'base' ? base : design, i);
    }

    function drawHeat() {
      // one pixel per hour on a 365 × 24 bitmap, scaled up without smoothing: crisp blocks at any width
      const off = document.createElement('canvas');
      off.width = days; off.height = 24;
      const ctx = off.getContext('2d')!;
      const img = ctx.createImageData(days, 24);
      for (let i = 0; i < data!.hours; i++) {
        const d = Math.floor(i / 24), h = i % 24; // h=0 is the hour ending at 1:00
        const y = 23 - h;
        const hex = colorAt(i);
        const p = (y * days + d) * 4;
        img.data[p] = parseInt(hex.slice(1, 3), 16);
        img.data[p + 1] = parseInt(hex.slice(3, 5), 16);
        img.data[p + 2] = parseInt(hex.slice(5, 7), 16);
        img.data[p + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
      const dpr = window.devicePixelRatio || 1;
      const w = plot.clientWidth, hgt = plot.clientHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(hgt * dpr);
      const c = canvas.getContext('2d')!;
      c.imageSmoothingEnabled = false;
      c.drawImage(off, 0, 0, canvas.width, canvas.height);
    }

    function drawMargins() {
      const { base, design } = data!.cases;
      const byHour = new Array(24).fill(0), byMonth = new Array(12).fill(0), monthHours = new Array(12).fill(0);
      let m = 0, dayInMonth = 0;
      for (let d = 0; d < days; d++) {
        for (let h = 0; h < 24; h++) {
          const i = d * 24 + h;
          let v: number;
          if (view === 'changed') v = (design.comfortable[i] === '1' ? 1 : 0) - (base.comfortable[i] === '1' ? 1 : 0);
          else v = (view === 'base' ? base : design).comfortable[i] === '1' ? 1 : 0;
          byHour[h] += v; byMonth[m] += v; monthHours[m]++;
        }
        if (++dayInMonth === MONTH_DAYS[m]) { m++; dayInMonth = 0; }
      }
      const diverging = view === 'changed';
      const pos = diverging ? CHANGED[0] : BINS[4];
      const neg = CHANGED[1];

      // by hour: horizontal bars, one per heatmap row
      const hs = document.createElementNS(svgNS, 'svg');
      const W = hoursBox.clientWidth, H = hoursBox.clientHeight;
      hs.setAttribute('viewBox', `0 0 ${W} ${H}`); hs.setAttribute('preserveAspectRatio', 'none');
      const hMax = diverging ? Math.max(...byHour.map(Math.abs)) : days;
      const zeroX = diverging ? W * 0.3 : 0, span = diverging ? W * 0.7 : W;
      const rowH = H / 24;
      if (diverging) { const z = rect(zeroX, 0, 1, H, 'var(--line-on-paper)', ''); hs.appendChild(z); }
      byHour.forEach((v, h) => {
        const len = (Math.abs(v) / hMax) * span * (diverging && v < 0 ? 0.3 / 0.7 : 1);
        const x = v >= 0 ? zeroX : zeroX - len;
        const label = t.hourSpan(h + 1);
        hs.appendChild(rect(x, (23 - h) * rowH + 0.5, len, rowH - 1, v >= 0 ? pos : neg,
          diverging ? t.tipHourNet(label, v) : t.tipHourCase(label, v)));
      });
      hoursBox.replaceChildren(hs);

      // by month: vertical bars under the month axis
      const ms = document.createElementNS(svgNS, 'svg');
      const MW = monthsBox.clientWidth, MH = monthsBox.clientHeight;
      ms.setAttribute('viewBox', `0 0 ${MW} ${MH}`); ms.setAttribute('preserveAspectRatio', 'none');
      const mMax = diverging ? Math.max(...byMonth.map(Math.abs)) : Math.max(...monthHours);
      let x0 = 0;
      byMonth.forEach((v, i) => {
        const w = (MONTH_DAYS[i] / days) * MW;
        const len = (Math.abs(v) / mMax) * MH;
        ms.appendChild(rect(x0 + w * 0.2, MH - len, w * 0.6, len, v >= 0 ? pos : neg,
          diverging ? t.tipMonthNet(t.months[i], v) : t.tipMonthCase(t.months[i], v, monthHours[i])));
        x0 += w;
      });
      monthsBox.replaceChildren(ms);
    }

    function drawStat() {
      const { base, design } = data!.cases;
      const nB = base.comfortable.split('1').length - 1, nD = design.comfortable.split('1').length - 1;
      if (view === 'changed') {
        let gained = 0, lost = 0;
        for (let i = 0; i < data!.hours; i++) {
          const a = base.comfortable[i] === '1', b = design.comfortable[i] === '1';
          if (!a && b) gained++; else if (a && !b) lost++;
        }
        big.textContent = t.statChanged(nD - nB);
        sub.textContent = t.subChanged(gained, lost);
      } else {
        const n = view === 'base' ? nB : nD;
        big.textContent = t.statCase(n);
        sub.textContent = t.subCase(Math.round((n / data!.hours) * 1000) / 10);
      }
    }

    function render() {
      if (!data) return;
      drawHeat(); drawMargins(); drawStat();
      legends.forEach((l) => (l.hidden = (l.dataset.legend === 'changed') !== (view === 'changed')));
    }

    function placeTip(clientX: number, clientY: number) {
      const box = fig.getBoundingClientRect();
      tip.hidden = false;
      let x = clientX - box.left + 14, y = clientY - box.top + 14;
      if (x + tip.offsetWidth > box.width) x = clientX - box.left - tip.offsetWidth - 14;
      if (x < 0) x = 0;
      tip.style.left = `${x}px`; tip.style.top = `${y}px`;
    }

    function hoverHeat(e: PointerEvent) {
      if (!data) return;
      const r = plot.getBoundingClientRect();
      const d = Math.min(days - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * days)));
      const row = Math.min(23, Math.max(0, Math.floor(((e.clientY - r.top) / r.height) * 24)));
      const h = 23 - row, i = d * 24 + h;
      cursor.hidden = false;
      cursor.style.left = `${(d / days) * 100}%`; cursor.style.width = `${100 / days}%`;
      cursor.style.top = `${(row / 24) * 100}%`; cursor.style.height = `${100 / 24}%`;
      const { base, design } = data.cases;
      const caseRow = (name: string, c: Case, cls: string) => {
        const s = stateOf(c, i);
        return `<div class="${cls}"><div class="t-row"><span>${name}</span><b>${deg(c.operative[i])}</b></div>` +
          `<div class="t-row"><span class="t-state"><i style="background:${binColor(c, i)}"></i>${t.state[s]}</span><b>${signed(c.fromTarget[i])} ${t.fromTarget}</b></div></div>`;
      };
      tip.innerHTML =
        `<div class="t-when">${dayLabel(d)} · ${t.hourSpan(h + 1)}</div>` +
        `<div class="t-row"><span>${t.outdoor}</span><b>${deg(data.outdoor[i])}</b></div>` +
        caseRow(caseNames[0], base, 't-case') + caseRow(caseNames[1], design, 't-case');
      placeTip(e.clientX, e.clientY);
    }

    function hoverBar(e: PointerEvent) {
      const target = e.target as SVGElement;
      const text = target instanceof SVGRectElement ? target.dataset.tip : '';
      if (!text) { tip.hidden = true; return; }
      tip.innerHTML = `<div class="t-when">${text}</div>`;
      placeTip(e.clientX, e.clientY);
    }
    const hide = () => { tip.hidden = true; cursor.hidden = true; };

    plot.addEventListener('pointermove', hoverHeat);
    plot.addEventListener('pointerdown', hoverHeat);
    plot.addEventListener('pointerleave', hide);
    [hoursBox, monthsBox].forEach((b) => { b.addEventListener('pointermove', hoverBar); b.addEventListener('pointerleave', hide); });
    buttons.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view as View;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    new ResizeObserver(() => render()).observe(plot);

    fetch(fig.dataset.src!)
      .then((r) => r.json())
      .then((json: Data) => { data = json; render(); })
      .catch(() => { sub.textContent = ''; });
  }

  // load each chart's data only when it scrolls near the viewport
  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => { if (en.isIntersecting) { io.unobserve(en.target); init(en.target as HTMLElement); } });
  }, { rootMargin: '400px' });
  document.querySelectorAll<HTMLElement>('.cmap').forEach((f) => io.observe(f));
</script>
