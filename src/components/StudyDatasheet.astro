---
// markup only: styles live in src/styles/study-page.css, which both study
// pages import. shared by /en/specification-studies and /en/modeling-support.
// the study datasheet. one value column, or several when `head` names them
// (a row's `v` is then an array, one entry per column).
interface Row { k: string; v: string | string[] }
interface Props { caption: string; rows: Row[]; head?: string[] }
const { caption, rows, head } = Astro.props;
const cols = head?.length ?? 1;
---

<table class:list={['datasheet', { multi: cols > 1 }]}>
  <caption>{caption}</caption>
  {head && (
    <thead>
      <tr><td></td>{head.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
  )}
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">{r.k}</th>
        {(Array.isArray(r.v) ? r.v : [r.v]).map((v, k) => <td class="ds-v" data-col={head?.[k]}>{v}</td>)}
      </tr>
    ))}
  </tbody>
</table>
