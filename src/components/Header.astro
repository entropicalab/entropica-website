---
import { tr, localized } from '../i18n/utils';
import type { Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
// english-only site: chrome links and labels are always english, also on the
// two spanish panamá tools that stay live.
const t = tr('en');

// 2026-11-24: modeling support became the home page, so it left the menu
// (the logo goes home) and the faq came back.
const navItems = [
  { key: 'nav.work' as const, path: '/projects' },
  { key: 'nav.journal' as const, path: '/blog' },
  { key: 'nav.about' as const, path: '/about' },
  { key: 'nav.faq' as const, path: '/faq' },
  { key: 'nav.contact' as const, path: '/contact' },
];

const isActive = (path: string): boolean => {
  const here = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
  const target = localized(path, 'en').replace(/\/$/, '');
  if (target === '/' || target === `/${locale}`) {
    return here === target;
  }
  return here === target || here.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/en/" aria-label="entrópica">
      <img src="/entropica-dark.png" alt="entrópica" width="200" height="56" />
    </a>
    <nav class="primary" aria-label="primary">
      {navItems.map((item) => (
        <a href={item.href ?? localized(item.path, 'en')} aria-current={isActive(item.path) ? 'page' : undefined}>
          {t(item.key)}
        </a>
      ))}
    </nav>
  </div>
</header>
