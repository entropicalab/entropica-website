---
// interactive hour-by-hour heatmap for simulation studies: 365 days across,
// 24 hours up, one square per hour, two cases (e.g. without / with the parasol).
// data: a compact json (see posters/web-data/*_json.py in each project folder)
//   { hours, outdoor[], cases: { base|design: { operative[], target[],
//     fromTarget[], comfortable: "0101…", <surface>[] … } } }  tenths of °C
// kinds:
//   comfort  views: what changed · case a · case b (adaptive comfort states)
//   surface  views: the difference · case a · case b (a surface temperature,
//            e.g. field="roof")
//   climate  views: air temperature · cooling from water (one weather year:
//            top-level outdoor[], humidity[], wetbulb[]; no cases)
// hover any hour for both cases; hover the margin bars for totals by hour of
// day and by month. all labels are html: searchable and restylable.
import type { Locale } from '../i18n/strings';

interface Props {
  kind: 'comfort' | 'surface' | 'climate';
  field?: string; // surface kind: which series, e.g. 'roof'
  src: string;
  cases: [string, string];
  alt: string;
  fallback: string; // poster image, shown if js is off
  locale: Locale;
}
const { kind, field = '', src, cases, alt, fallback, locale } = Astro.props;

const L = {
  en: {
    first: { comfort: 'what changed', surface: 'the difference', climate: 'air temperature' },
    second: 'cooling from water',
    months: ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'],
    byHour: 'by hour of day',
    byMonth: 'by month',
    loading: 'loading 8,760 hours…',
    comfortChanged: ['became comfortable', 'became too cool', 'became too warm', 'unchanged: comfortable', 'unchanged: too warm', 'unchanged: too cool'],
    comfortCase: 'degrees from the comfort target (°C). sand = comfortable',
    surfaceDiff: (c: string) => `how much cooler ${c} (°C)`,
    surfaceCase: 'surface temperature, outside face (°C)',
    airTitle: 'air temperature outdoors (°C)',
    wbTitle: 'cooling available from evaporating water: air minus wet-bulb temperature (°C)',
  },
  es: {
    first: { comfort: 'qué cambió', surface: 'la diferencia', climate: 'temperatura del aire' },
    second: 'enfriamiento con agua',
    months: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
    byHour: 'por hora del día',
    byMonth: 'por mes',
    loading: 'cargando 8,760 horas…',
    comfortChanged: ['pasó a confort', 'pasó a demasiado frío', 'pasó a demasiado calor', 'sin cambio: en confort', 'sin cambio: demasiado calor', 'sin cambio: demasiado frío'],
    comfortCase: 'grados respecto al objetivo de confort (°C). arena = confort',
    surfaceDiff: (c: string) => `cuánto más fresco ${c} (°C)`,
    surfaceCase: 'temperatura superficial, cara exterior (°C)',
    airTitle: 'temperatura del aire exterior (°C)',
    wbTitle: 'enfriamiento disponible al evaporar agua: aire menos temperatura de bulbo húmedo (°C)',
  },
}[locale];

// keep in sync with the script below
const PAL = {
  changed: ['#fab31e', '#5a98a0', '#c8714f', '#e9e3d6', '#ecd3c4', '#d2e2e1'],
  comfort: ['#014555', '#236e7d', '#5a98a0', '#96c1c3', '#e3ddd0', '#deab8a', '#c8714f', '#a0422d', '#6b1e1b'],
  comfortTicks: ['−10', '−6', '−4', '−2.5', '2.5', '4', '6', '10'],
  temp: ['#fde4d4', '#f6c0a8', '#ea957a', '#d36b56', '#b1483c', '#892a29', '#5b161a'],
  tempTicks: ['25', '30', '35', '40', '45', '55'],
  diff: ['#c8714f', '#e2b29a', '#e9e3d6', '#f8dfa8', '#fccb6a', '#fab31e', '#d9900c', '#a96a05'],
  diffTicks: ['−3', '−1', '1', '5', '10', '15', '20'],
  air: ['#fde4d4', '#f6c0a8', '#ea957a', '#d36b56', '#b1483c', '#892a29', '#5b161a'],
  airTicks: ['20', '25', '30', '35', '40', '45'],
  wb: ['#eef2ef', '#d2e2e1', '#96c1c3', '#5a98a0', '#236e7d', '#014555'],
  wbTicks: ['4', '8', '12', '16', '20'],
};
const scale = (colors: string[], ticks: string[], title: string) => ({ colors, ticks, title });
const legendFirst = kind === 'surface' ? scale(PAL.diff, PAL.diffTicks, L.surfaceDiff(cases[1])) : kind === 'climate' ? scale(PAL.air, PAL.airTicks, L.airTitle) : null;
const legendCase =
  kind === 'surface' ? scale(PAL.temp, PAL.tempTicks, L.surfaceCase) : kind === 'climate' ? scale(PAL.wb, PAL.wbTicks, L.wbTitle) : scale(PAL.comfort, PAL.comfortTicks, L.comfortCase);
---

<figure class="cmap" data-kind={kind} data-field={field} data-src={src} data-locale={locale} data-cases={JSON.stringify(cases)}>
  <div class="cmap-bar">
    <div class="cmap-views" role="group">
      <button type="button" data-view="first" aria-pressed="true">{L.first[kind]}</button>
      <button type="button" data-view="base" aria-pressed="false">{kind === 'climate' ? L.second : cases[0]}</button>
      {kind !== 'climate' && <button type="button" data-view="design" aria-pressed="false">{cases[1]}</button>}
    </div>
    <div class="cmap-stat" aria-live="polite">
      <span class="cmap-stat-big"></span>
      <span class="cmap-stat-sub">{L.loading}</span>
    </div>
  </div>

  <div class="cmap-grid">
    <div class="cmap-months-label">{L.byMonth}</div>
    <div class="cmap-months" aria-hidden="true"></div>
    <div></div>

    <div class="cmap-yaxis" aria-hidden="true"><span>24h</span><span>12h</span><span>0h</span></div>
    <div class="cmap-plot">
      <canvas role="img" aria-label={alt}></canvas>
      <div class="cmap-cursor" hidden></div>
    </div>
    <div class="cmap-hours" aria-hidden="true"></div>

    <div></div>
    <div class="cmap-xaxis" aria-hidden="true">{L.months.map((m) => <span>{m}</span>)}</div>
    <div class="cmap-hours-label">{L.byHour}</div>
  </div>

  {kind === 'comfort' ? (
    <div class="cmap-legend chips" data-legend="first">
      {L.comfortChanged.map((l, i) => (
        <span class="lg-item"><i style={`background:${PAL.changed[i]}`}></i>{l}</span>
      ))}
    </div>
  ) : (
    <div class="cmap-legend" data-legend="first">
      <div class="lg-title">{legendFirst!.title}</div>
      <div class="lg-scale" style={`--n:${legendFirst!.colors.length}`}>{legendFirst!.colors.map((c) => <i style={`background:${c}`}></i>)}</div>
      <div class="lg-ticks" style={`--n:${legendFirst!.colors.length}`}>{legendFirst!.ticks.map((t) => <span>{t}</span>)}</div>
    </div>
  )}
  <div class="cmap-legend" data-legend="case" hidden>
    <div class="lg-title">{legendCase.title}</div>
    <div class="lg-scale" style={`--n:${legendCase.colors.length}`}>{legendCase.colors.map((c) => <i style={`background:${c}`}></i>)}</div>
    <div class="lg-ticks" style={`--n:${legendCase.colors.length}`}>{legendCase.ticks.map((t) => <span>{t}</span>)}</div>
  </div>

  <div class="cmap-tip" hidden></div>
  <noscript><img src={fallback} alt={alt} width="2160" height="2200" style="width:100%;height:auto" /></noscript>
</figure>

<style>
  .cmap { margin: 0; position: relative; }
  .cmap :global(*) { text-transform: none; }

  .cmap-bar { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 20px; }
  .cmap-views { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--line-on-paper); }
  .cmap-views button {
    font: inherit;
    font-size: 13px;
    padding: 8px 14px;
    background: transparent;
    color: var(--mute-on-paper);
    border: 0;
    border-left: 1px solid var(--line-on-paper);
    cursor: pointer;
  }
  .cmap-views button:first-child { border-left: 0; }
  .cmap-views button:hover { color: var(--ink-on-paper); }
  .cmap-views button[aria-pressed='true'] { background: var(--ink-on-paper); color: var(--paper); }
  .cmap-stat { display: flex; flex-direction: column; gap: 2px; }
  .cmap-stat-big { font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em; font-feature-settings: 'tnum' 1; }
  .cmap-stat-sub { font-size: 13px; color: var(--mute-on-paper); max-width: 52ch; }

  .cmap-grid {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 72px;
    column-gap: 10px;
    row-gap: 6px;
  }
  .cmap-yaxis {
    display: flex; flex-direction: column; justify-content: space-between;
    font-size: 11px; color: var(--mute-on-paper-2); text-align: right; font-feature-settings: 'tnum' 1;
  }
  .cmap-yaxis span { line-height: 1; transform: translateY(-1px); }
  /* one square cell per hour: 365 days across, 24 hours up */
  .cmap-plot { position: relative; aspect-ratio: 365 / 24; cursor: crosshair; }
  .cmap-plot canvas { display: block; width: 100%; height: 100%; }
  .cmap-cursor { position: absolute; pointer-events: none; outline: 1.5px solid var(--ink-on-paper); outline-offset: 0; }
  .cmap-xaxis { display: grid; grid-template-columns: repeat(12, 1fr); font-size: 11px; color: var(--mute-on-paper-2); }
  .cmap-hours, .cmap-months { position: relative; }
  .cmap-hours-label, .cmap-months-label { font-size: 10px; letter-spacing: 0.08em; color: var(--mute-on-paper-2); line-height: 1.3; }
  .cmap-months-label { text-align: right; align-self: end; }
  .cmap-months { height: 36px; }
  .cmap-hours :global(svg), .cmap-months :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cmap-hours :global(rect), .cmap-months :global(rect) { cursor: default; }
  .cmap-hours :global(rect:hover), .cmap-months :global(rect:hover) { opacity: 0.7; }

  .cmap-legend { margin-top: 18px; font-size: 12px; color: var(--mute-on-paper); }
  .cmap-legend.chips { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .cmap-legend[hidden] { display: none; }
  .lg-item { display: inline-flex; align-items: center; gap: 8px; }
  .lg-item i, .lg-scale i { display: inline-block; height: 12px; }
  .lg-item i { width: 18px; }
  .lg-title { margin-bottom: 8px; }
  .lg-scale { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 2px; max-width: 560px; }
  .lg-scale i { width: 100%; }
  /* ticks sit on the boundaries between swatches */
  .lg-ticks { display: grid; grid-template-columns: 0.5fr repeat(calc(var(--n) - 1), 1fr) 0.5fr; max-width: 560px; margin-top: 4px; font-size: 11px; font-feature-settings: 'tnum' 1; }
  .lg-ticks span { text-align: center; }
  .lg-ticks span:first-child { grid-column: 2; }

  .cmap-tip {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    background: var(--paper);
    border: 1px solid var(--ink-on-paper);
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
    min-width: 220px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .cmap-tip[hidden] { display: none; }
  .cmap-tip :global(.t-when) { font-size: 13px; color: var(--ink-on-paper); margin-bottom: 4px; }
  .cmap-tip :global(.t-row) { display: flex; justify-content: space-between; gap: 16px; color: var(--mute-on-paper); }
  .cmap-tip :global(.t-row b) { color: var(--ink-on-paper); font-weight: 500; font-feature-settings: 'tnum' 1; white-space: nowrap; }
  .cmap-tip :global(.t-case) { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line-on-paper-2); }
  .cmap-tip :global(.t-state) { display: inline-flex; align-items: center; gap: 6px; }
  .cmap-tip :global(.t-state i) { width: 9px; height: 9px; display: inline-block; }

  @media (max-width: 640px) {
    .cmap-grid { grid-template-columns: 30px minmax(0, 1fr) 44px; column-gap: 6px; }
    /* too thin to read or tap at phone width: keep a floor, cells stretch here */
    /* (a min-height with the aspect ratio would widen the plot past the screen) */
    .cmap-plot { aspect-ratio: auto; height: 96px; }
    .cmap-xaxis span:nth-child(even) { visibility: hidden; }
    .cmap-hours-label, .cmap-months-label { font-size: 9px; }
  }
</style>

<script>
  import { loadStudyData, MONTH_DAYS, MONTHS, hourSpan, deg, signedDeg } from '../scripts/study-data';

  type Case = { operative: number[]; target: number[]; fromTarget: number[]; comfortable: string; [k: string]: number[] | string };
  type Data = { hours: number; band?: number; outdoor: number[]; humidity?: number[]; wetbulb?: number[]; cases: { base: Case; design: Case } };
  type View = 'first' | 'base' | 'design';
  type State = 'ok' | 'hot' | 'cold';
  type Locale = 'en' | 'es';

  const PAL = {
    changed: ['#fab31e', '#5a98a0', '#c8714f', '#e9e3d6', '#ecd3c4', '#d2e2e1'],
    comfort: ['#014555', '#236e7d', '#5a98a0', '#96c1c3', '#e3ddd0', '#deab8a', '#c8714f', '#a0422d', '#6b1e1b'],
    temp: ['#fde4d4', '#f6c0a8', '#ea957a', '#d36b56', '#b1483c', '#892a29', '#5b161a'],
    diff: ['#c8714f', '#e2b29a', '#e9e3d6', '#f8dfa8', '#fccb6a', '#fab31e', '#d9900c', '#a96a05'],
    air: ['#fde4d4', '#f6c0a8', '#ea957a', '#d36b56', '#b1483c', '#892a29', '#5b161a'],
    wb: ['#eef2ef', '#d2e2e1', '#96c1c3', '#5a98a0', '#236e7d', '#014555'],
  };
  const EDGES = { comfort: [-10, -6, -4, -2.5, 2.5, 4, 6, 10], temp: [25, 30, 35, 40, 45, 55], diff: [-3, -1, 1, 5, 10, 15, 20], air: [20, 25, 30, 35, 40, 45], wb: [4, 8, 12, 16, 20] };
  const HOT_AIR = 35; // the study counts evaporative potential in the hours above 35 °C
  // value -> swatch index for a list of ascending bin edges
  const bin = (v: number, edges: number[]) => { let k = 0; while (k < edges.length && v >= edges[k]) k++; return k; };
  const HOT = 45; // surface threshold quoted in the study

  const T = {
    en: {
      outdoor: 'outdoors',
      fromTarget: 'from target',
      cooler: 'cooler',
      warmer: 'warmer',
      diffRow: 'difference',
      state: { ok: 'comfortable', hot: 'too warm', cold: 'too cool' } as Record<State, string>,
      n: (v: number) => v.toLocaleString('en-US'),
      // comfort
      statChanged: (net: string) => `${net} comfortable hours a year`,
      subChanged: (g: string, l: string) => `${g} ${g === '1' ? 'hour becomes' : 'hours become'} comfortable, ${l} ${l === '1' ? 'stops' : 'stop'} being comfortable.`,
      statCase: (n: string) => `${n} comfortable hours a year`,
      subCase: (pct: number) => `${pct}% of the year, no air-conditioning.`,
      tipHourNet: (h: string, v: string) => `${h}: ${v} comfortable hours over the year`,
      tipHourCase: (h: string, v: number) => `${h}: comfortable on ${v} of 365 days`,
      tipMonthNet: (m: string, v: string) => `${m}: ${v} comfortable hours`,
      tipMonthCase: (m: string, v: number, of: number) => `${m}: ${v} of ${of} hours comfortable`,
      // surface
      statDiff: (d: string, a: string, b: string) => `${d} at the hottest hour (${a} → ${b})`,
      subDiff: (n: string, m: string, a: string, b: string) => `${n} hours a year above 45 °C ${a}, ${m} ${b}.`,
      statPeak: (p: string) => `peak ${p}`,
      subPeak: (n: string) => `${n} hours a year above 45 °C.`,
      tipHourDiff: (h: string, v: string) => `${h}: ${v} on average`,
      tipHourMean: (h: string, v: string) => `${h}: ${v} on average`,
      // climate
      statAir: (n: string) => `${n} hours a year above 35 °C outdoors`,
      subAir: (p: string) => `the hottest hour reaches ${p}.`,
      statWb: (m: string) => `${m} median cooling from evaporating water in the hours above 35 °C`,
      subWb: (p: string) => `up to ${p}: the hotter the air, the drier it is.`,
      humidity: 'humidity',
      wetbulb: 'wet bulb',
      evap: 'cooling from water',
    },
    es: {
      outdoor: 'exterior',
      fromTarget: 'del objetivo',
      cooler: 'más fresco',
      warmer: 'más cálido',
      diffRow: 'diferencia',
      state: { ok: 'en confort', hot: 'demasiado calor', cold: 'demasiado frío' } as Record<State, string>,
      n: (v: number) => v.toLocaleString('en-US'),
      statChanged: (net: string) => `${net} horas en confort al año`,
      subChanged: (g: string, l: string) => `${g} ${g === '1' ? 'hora pasa' : 'horas pasan'} a confort y ${l} ${l === '1' ? 'deja' : 'dejan'} de estarlo.`,
      statCase: (n: string) => `${n} horas en confort al año`,
      subCase: (pct: number) => `${pct}% del año, sin aire acondicionado.`,
      tipHourNet: (h: string, v: string) => `${h}: ${v} horas en confort en el año`,
      tipHourCase: (h: string, v: number) => `${h}: en confort ${v} de 365 días`,
      tipMonthNet: (m: string, v: string) => `${m}: ${v} horas en confort`,
      tipMonthCase: (m: string, v: number, of: number) => `${m}: ${v} de ${of} horas en confort`,
      statDiff: (d: string, a: string, b: string) => `${d} en la hora más caliente (${a} → ${b})`,
      subDiff: (n: string, m: string, a: string, b: string) => `${n} horas al año sobre 45 °C ${a}, ${m} ${b}.`,
      statPeak: (p: string) => `máximo de ${p}`,
      subPeak: (n: string) => `${n} horas al año sobre 45 °C.`,
      tipHourDiff: (h: string, v: string) => `${h}: ${v} en promedio`,
      tipHourMean: (h: string, v: string) => `${h}: ${v} en promedio`,
      statAir: (n: string) => `${n} horas al año sobre 35 °C afuera`,
      subAir: (p: string) => `la hora más caliente llega a ${p}.`,
      statWb: (m: string) => `${m} de enfriamiento mediano al evaporar agua en las horas sobre 35 °C`,
      subWb: (p: string) => `hasta ${p}: cuanto más caliente el aire, más seco.`,
      humidity: 'humedad',
      wetbulb: 'bulbo húmedo',
      evap: 'enfriamiento con agua',
    },
  };
  const signedInt = (v: number) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toLocaleString('en-US')}`;

  const svgNS = 'http://www.w3.org/2000/svg';
  function rect(x: number, y: number, w: number, h: number, fill: string, tip: string): SVGRectElement {
    const r = document.createElementNS(svgNS, 'rect');
    r.setAttribute('x', String(x)); r.setAttribute('y', String(y));
    r.setAttribute('width', String(Math.max(0, w))); r.setAttribute('height', String(Math.max(0, h)));
    r.setAttribute('fill', fill); r.dataset.tip = tip;
    return r;
  }

  function init(fig: HTMLElement) {
    const locale: Locale = fig.dataset.locale === 'es' ? 'es' : 'en';
    const t = T[locale];
    const kind = fig.dataset.kind === 'surface' ? 'surface' : fig.dataset.kind === 'climate' ? 'climate' : 'comfort';
    const field = fig.dataset.field ?? '';
    const caseNames = JSON.parse(fig.dataset.cases ?? '["a","b"]') as [string, string];
    const canvas = fig.querySelector('canvas') as HTMLCanvasElement;
    const plot = fig.querySelector('.cmap-plot') as HTMLElement;
    const cursor = fig.querySelector('.cmap-cursor') as HTMLElement;
    const tip = fig.querySelector('.cmap-tip') as HTMLElement;
    const big = fig.querySelector('.cmap-stat-big') as HTMLElement;
    const sub = fig.querySelector('.cmap-stat-sub') as HTMLElement;
    const hoursBox = fig.querySelector('.cmap-hours') as HTMLElement;
    const monthsBox = fig.querySelector('.cmap-months') as HTMLElement;
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('.cmap-views button')];
    const legends = [...fig.querySelectorAll<HTMLElement>('.cmap-legend')];
    const months = MONTHS[locale];
    const days = 365;

    let data: Data | null = null;
    // comfort band edges; a study on the 80% band (± 3.5 °C) sends band: 35
    let comfortEdges = EDGES.comfort;
    let view: View = 'first';

    // ---- per-kind behaviour ------------------------------------------------
    const stateOf = (c: Case, i: number): State => (c.comfortable[i] === '1' ? 'ok' : c.fromTarget[i] > 0 ? 'hot' : 'cold');
    const comfortColor = (c: Case, i: number) => {
      if (c.comfortable[i] === '1') return PAL.comfort[4];
      const v = c.fromTarget[i] / 10;
      const k = bin(v, comfortEdges);
      return PAL.comfort[v > 0 ? Math.max(5, k) : Math.min(3, k)];
    };
    const series = (c: Case) => c[field] as number[];
    const tempColor = (c: Case, i: number) => PAL.temp[bin(series(c)[i] / 10, EDGES.temp)];
    const diffAt = (i: number) => (series(data!.cases.base)[i] - series(data!.cases.design)[i]) / 10;

    const depression = (i: number) => (data!.outdoor[i] - data!.wetbulb![i]) / 10;

    function colorAt(i: number): string {
      const { base, design } = data!.cases;
      if (kind === 'climate') return view === 'first' ? PAL.air[bin(data!.outdoor[i] / 10, EDGES.air)] : PAL.wb[bin(depression(i), EDGES.wb)];
      if (kind === 'comfort') {
        if (view === 'first') {
          const a = stateOf(base, i), b = stateOf(design, i);
          return PAL.changed[a === b ? (a === 'ok' ? 3 : a === 'hot' ? 4 : 5) : b === 'ok' ? 0 : b === 'cold' ? 1 : 2];
        }
        return comfortColor(view === 'base' ? base : design, i);
      }
      if (view === 'first') return PAL.diff[bin(diffAt(i), EDGES.diff)];
      return tempColor(view === 'base' ? base : design, i);
    }

    // value per hour feeding the margin bars, how they sum, and their tooltips
    function margin() {
      const { base, design } = data!.cases;
      if (kind === 'climate') {
        return view === 'first'
          ? { value: (i: number) => data!.outdoor[i] / 10, mean: true, pos: PAL.air[3], neg: PAL.air[3],
              tipH: (h: string, v: number) => t.tipHourMean(h, deg(v * 10)), tipM: (m: string, v: number) => t.tipHourMean(m, deg(v * 10)) }
          : { value: (i: number) => depression(i), mean: true, pos: PAL.wb[3], neg: PAL.wb[3],
              tipH: (h: string, v: number) => t.tipHourMean(h, deg(v * 10)), tipM: (m: string, v: number) => t.tipHourMean(m, deg(v * 10)) };
      }
      if (kind === 'comfort') {
        const ok = (c: Case, i: number) => (c.comfortable[i] === '1' ? 1 : 0);
        return view === 'first'
          ? { value: (i: number) => ok(design, i) - ok(base, i), mean: false, pos: PAL.changed[0], neg: PAL.changed[1],
              tipH: (h: string, v: number) => t.tipHourNet(h, signedInt(v)), tipM: (m: string, v: number) => t.tipMonthNet(m, signedInt(v)) }
          : { value: (i: number) => ok(view === 'base' ? base : design, i), mean: false, pos: '#cbbd9f', neg: '#cbbd9f', // darker sand: the swatch itself vanishes on paper
              tipH: (h: string, v: number) => t.tipHourCase(h, v), tipM: (m: string, v: number, of: number) => t.tipMonthCase(m, v, of) };
      }
      return view === 'first'
        ? { value: (i: number) => diffAt(i), mean: true, pos: PAL.diff[5], neg: PAL.diff[0],
            tipH: (h: string, v: number) => t.tipHourDiff(h, `${signedDeg(-v * 10)}`), tipM: (m: string, v: number) => t.tipHourDiff(m, `${signedDeg(-v * 10)}`) }
        : { value: (i: number) => series(view === 'base' ? base : design)[i] / 10, mean: true, pos: PAL.temp[4], neg: PAL.temp[4],
            tipH: (h: string, v: number) => t.tipHourMean(h, deg(v * 10)), tipM: (m: string, v: number) => t.tipHourMean(m, deg(v * 10)) };
    }

    function stat(): [string, string] {
      const { base, design } = data!.cases;
      if (kind === 'climate') {
        const out = data!.outdoor;
        if (view === 'first') return [t.statAir(t.n(out.filter((v) => v > HOT_AIR * 10).length)), t.subAir(deg(Math.max(...out)))];
        const hot = out.map((v, i) => (v > HOT_AIR * 10 ? depression(i) : NaN)).filter((v) => !Number.isNaN(v)).sort((a, b) => a - b);
        const med = hot.length % 2 ? hot[(hot.length - 1) / 2] : (hot[hot.length / 2 - 1] + hot[hot.length / 2]) / 2;
        const all = out.map((_, i) => depression(i));
        return [t.statWb(`${Math.round(med)} °C`), t.subWb(deg(Math.max(...all) * 10))];
      }
      if (kind === 'comfort') {
        const nB = base.comfortable.split('1').length - 1, nD = design.comfortable.split('1').length - 1;
        if (view === 'first') {
          let g = 0, l = 0;
          for (let i = 0; i < data!.hours; i++) {
            const a = base.comfortable[i] === '1', b = design.comfortable[i] === '1';
            if (!a && b) g++; else if (a && !b) l++;
          }
          return [t.statChanged(signedInt(nD - nB)), t.subChanged(t.n(g), t.n(l))];
        }
        const n = view === 'base' ? nB : nD;
        return [t.statCase(t.n(n)), t.subCase(Math.round((n / data!.hours) * 1000) / 10)];
      }
      const sB = series(base), sD = series(design);
      const pB = Math.max(...sB), pD = Math.max(...sD);
      const above = (s: number[]) => s.filter((v) => v > HOT * 10).length;
      if (view === 'first') return [t.statDiff(signedDeg(pD - pB), deg(pB), deg(pD)), t.subDiff(t.n(above(sB)), t.n(above(sD)), caseNames[0], caseNames[1])];
      const s = view === 'base' ? sB : sD;
      return [t.statPeak(deg(Math.max(...s))), t.subPeak(t.n(above(s)))];
    }

    function tipRows(i: number): string {
      const { base, design } = data!.cases;
      if (kind === 'climate') {
        return `<div class="t-row"><span>${t.humidity}</span><b>${data!.humidity![i]}%</b></div>` +
          `<div class="t-row"><span>${t.wetbulb}</span><b>${deg(data!.wetbulb![i])}</b></div>` +
          `<div class="t-case"><div class="t-row"><span class="t-state"><i style="background:${PAL.wb[bin(depression(i), EDGES.wb)]}"></i>${t.evap}</span><b>${deg(depression(i) * 10)}</b></div></div>`;
      }
      const block = (name: string, c: Case) => {
        if (kind === 'comfort') {
          return `<div class="t-case"><div class="t-row"><span>${name}</span><b>${deg(c.operative[i])}</b></div>` +
            `<div class="t-row"><span class="t-state"><i style="background:${comfortColor(c, i)}"></i>${t.state[stateOf(c, i)]}</span><b>${signedDeg(c.fromTarget[i])} ${t.fromTarget}</b></div></div>`;
        }
        return `<div class="t-row"><span class="t-state"><i style="background:${tempColor(c, i)}"></i>${name}</span><b>${deg(series(c)[i])}</b></div>`;
      };
      if (kind === 'comfort') return block(caseNames[0], base) + block(caseNames[1], design);
      const d = diffAt(i);
      return `<div class="t-case">${block(caseNames[0], base)}${block(caseNames[1], design)}</div>` +
        `<div class="t-case"><div class="t-row"><span>${t.diffRow}</span><b>${signedDeg(-d * 10)} ${d >= 0 ? t.cooler : t.warmer}</b></div></div>`;
    }

    // ---- drawing -------------------------------------------------------------
    function dayLabel(d: number): string {
      let m = 0, rest = d;
      while (rest >= MONTH_DAYS[m]) { rest -= MONTH_DAYS[m]; m++; }
      return `${rest + 1} ${months[m]}`;
    }

    function drawHeat() {
      // one pixel per hour on a 365 × 24 bitmap, scaled up without smoothing: crisp squares at any width
      const off = document.createElement('canvas');
      off.width = days; off.height = 24;
      const ctx = off.getContext('2d')!;
      const img = ctx.createImageData(days, 24);
      for (let i = 0; i < data!.hours; i++) {
        const d = Math.floor(i / 24), h = i % 24; // h=0 is the hour ending at 1:00
        const hex = colorAt(i);
        const p = ((23 - h) * days + d) * 4;
        img.data[p] = parseInt(hex.slice(1, 3), 16);
        img.data[p + 1] = parseInt(hex.slice(3, 5), 16);
        img.data[p + 2] = parseInt(hex.slice(5, 7), 16);
        img.data[p + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(plot.clientWidth * dpr); canvas.height = Math.round(plot.clientHeight * dpr);
      const c = canvas.getContext('2d')!;
      c.imageSmoothingEnabled = false;
      c.drawImage(off, 0, 0, canvas.width, canvas.height);
    }

    function drawMargins() {
      const mg = margin();
      const byHour = new Array(24).fill(0), byMonth = new Array(12).fill(0), monthHours = new Array(12).fill(0);
      let m = 0, dayInMonth = 0;
      for (let d = 0; d < days; d++) {
        for (let h = 0; h < 24; h++) { const v = mg.value(d * 24 + h); byHour[h] += v; byMonth[m] += v; monthHours[m]++; }
        if (++dayInMonth === MONTH_DAYS[m]) { m++; dayInMonth = 0; }
      }
      if (mg.mean) { byHour.forEach((_, h) => (byHour[h] /= days)); byMonth.forEach((_, k) => (byMonth[k] /= monthHours[k])); }

      // bars share a zero line placed by the negative share of the range
      const extent = (arr: number[]) => ({ lo: Math.min(0, ...arr), hi: Math.max(0, ...arr) });

      const hs = document.createElementNS(svgNS, 'svg');
      const W = hoursBox.clientWidth, H = hoursBox.clientHeight, rowH = H / 24;
      hs.setAttribute('viewBox', `0 0 ${W} ${H}`); hs.setAttribute('preserveAspectRatio', 'none');
      const he = extent(byHour), hSpan = he.hi - he.lo || 1, zx = (-he.lo / hSpan) * W;
      if (he.lo < 0) hs.appendChild(rect(zx, 0, 1, H, 'var(--line-on-paper)', ''));
      byHour.forEach((v, h) => {
        const len = (Math.abs(v) / hSpan) * W;
        hs.appendChild(rect(v >= 0 ? zx : zx - len, (23 - h) * rowH + 0.5, len, rowH - 1, v >= 0 ? mg.pos : mg.neg, mg.tipH(hourSpan(locale, h + 1), v)));
      });
      hoursBox.replaceChildren(hs);

      const ms = document.createElementNS(svgNS, 'svg');
      const MW = monthsBox.clientWidth, MH = monthsBox.clientHeight;
      ms.setAttribute('viewBox', `0 0 ${MW} ${MH}`); ms.setAttribute('preserveAspectRatio', 'none');
      const me = extent(byMonth), mSpan = me.hi - me.lo || 1, zy = (me.hi / mSpan) * MH;
      let x0 = 0;
      byMonth.forEach((v, k) => {
        const w = (MONTH_DAYS[k] / days) * MW, len = (Math.abs(v) / mSpan) * MH;
        ms.appendChild(rect(x0 + w * 0.2, v >= 0 ? zy - len : zy, w * 0.6, len, v >= 0 ? mg.pos : mg.neg, mg.tipM(months[k], v, monthHours[k])));
        x0 += w;
      });
      monthsBox.replaceChildren(ms);
    }

    function render() {
      if (!data) return;
      drawHeat(); drawMargins();
      [big.textContent, sub.textContent] = stat();
      legends.forEach((l) => (l.hidden = (l.dataset.legend === 'first') !== (view === 'first')));
    }

    // ---- interaction -----------------------------------------------------------
    function placeTip(clientX: number, clientY: number) {
      const box = fig.getBoundingClientRect();
      tip.hidden = false;
      let x = clientX - box.left + 14;
      if (x + tip.offsetWidth > box.width) x = clientX - box.left - tip.offsetWidth - 14;
      tip.style.left = `${Math.max(0, x)}px`; tip.style.top = `${clientY - box.top + 14}px`;
    }
    function hoverHeat(e: PointerEvent) {
      if (!data) return;
      const r = plot.getBoundingClientRect();
      const d = Math.min(days - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * days)));
      const row = Math.min(23, Math.max(0, Math.floor(((e.clientY - r.top) / r.height) * 24)));
      const h = 23 - row, i = d * 24 + h;
      cursor.hidden = false;
      cursor.style.left = `${(d / days) * 100}%`; cursor.style.width = `${100 / days}%`;
      cursor.style.top = `${(row / 24) * 100}%`; cursor.style.height = `${100 / 24}%`;
      tip.innerHTML = `<div class="t-when">${dayLabel(d)} · ${hourSpan(locale, h + 1)}</div>` +
        `<div class="t-row"><span>${t.outdoor}</span><b>${deg(data.outdoor[i])}</b></div>` + tipRows(i);
      placeTip(e.clientX, e.clientY);
    }
    function hoverBar(e: PointerEvent) {
      const text = e.target instanceof SVGRectElement ? e.target.dataset.tip : '';
      if (!text) { tip.hidden = true; return; }
      tip.innerHTML = `<div class="t-when">${text}</div>`;
      placeTip(e.clientX, e.clientY);
    }
    const hide = () => { tip.hidden = true; cursor.hidden = true; };

    plot.addEventListener('pointermove', hoverHeat);
    plot.addEventListener('pointerdown', hoverHeat);
    plot.addEventListener('pointerleave', hide);
    [hoursBox, monthsBox].forEach((b) => { b.addEventListener('pointermove', hoverBar); b.addEventListener('pointerleave', hide); });
    buttons.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view as View;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    new ResizeObserver(() => render()).observe(plot);

    loadStudyData<Data>(fig.dataset.src!).then((json) => {
      data = json;
      if (kind === 'comfort' && json.band && json.band !== 25) {
        const b = json.band / 10;
        comfortEdges = [-10, -6, -(b + 1.5), -b, b, b + 1.5, 6, 10];
        const fmt = (v: number) => `${v < 0 ? '−' : ''}${Math.abs(v)}`;
        fig.querySelectorAll('[data-legend="case"] .lg-ticks span').forEach((s, i) => (s.textContent = fmt(comfortEdges[i])));
      }
      render();
    }).catch(() => { sub.textContent = ''; });
  }

  // load each chart's data only when it scrolls near the viewport
  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => { if (en.isIntersecting) { io.unobserve(en.target); init(en.target as HTMLElement); } });
  }, { rootMargin: '400px' });
  document.querySelectorAll<HTMLElement>('.cmap').forEach((f) => io.observe(f));
</script>
