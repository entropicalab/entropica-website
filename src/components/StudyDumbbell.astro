---
// interactive dot chart for simulation studies: one row per item (e.g. room),
// a dot for each of two cases joined by a line, and the change at the end.
// hover or tap a row to read both values and its note (e.g. how much glass the
// room has). values are authored in the project's content file; a real table
// under the chart carries them too.
import type { Locale } from '../i18n/strings';

interface Props {
  rows: { label: string; a: number; b: number; note?: string }[];
  cases: [string, string];
  xLabel: string;
  xUnit?: string;
  alt: string;
  locale: Locale;
}
const { rows, cases, xLabel, xUnit = '', alt, locale } = Astro.props;
const changeHead = { en: 'change', es: 'cambio' }[locale];
const sortLabels = { en: ['as listed', 'by change'], es: ['en orden', 'por cambio'] }[locale];
const f1 = (v: number) => v.toFixed(1);
const sd = (v: number) => `${v < 0 ? '−' : '+'}${Math.abs(v).toFixed(1)}`;
---

<figure class="sdumb" role="group" aria-label={alt} data-rows={JSON.stringify(rows)} data-cases={JSON.stringify(cases)} data-xunit={xUnit}>
  <div class="sdumb-bar">
    <div class="sdumb-legend"><span><i class="s0"></i>{cases[0]}</span><span><i class="s1"></i>{cases[1]}</span></div>
    <div class="sdumb-sort" role="group">
      <button type="button" data-sort="list" aria-pressed="true">{sortLabels[0]}</button>
      <button type="button" data-sort="change" aria-pressed="false">{sortLabels[1]}</button>
    </div>
  </div>
  <div class="sdumb-plot"></div>
  <div class="sdumb-xlabel">{xLabel}</div>
  <table class="sdumb-table">
    <thead><tr><th></th><th>{cases[0]}</th><th>{cases[1]}</th><th>{changeHead}</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr><td>{r.label}</td><td>{f1(r.a)}{xUnit}</td><td>{f1(r.b)}{xUnit}</td><td>{sd(r.b - r.a)}</td></tr>
      ))}
    </tbody>
  </table>
  <div class="sdumb-tip" hidden></div>
</figure>

<style>
  .sdumb { margin: 0; position: relative; max-width: 820px; --dot-a: #5b564a; }
  .sdumb :global(*) { text-transform: none; }
  .sdumb-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; margin-bottom: 14px; }
  .sdumb-legend { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 12px; }
  .sdumb-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .sdumb-legend i { width: 11px; height: 11px; border-radius: 50%; background: var(--dot-a); }
  .sdumb-legend i.s1 { background: var(--amber); }
  .sdumb-sort { display: inline-flex; border: 1px solid var(--line-on-paper); }
  .sdumb-sort button { font: inherit; font-size: 12px; padding: 6px 12px; background: none; border: 0; color: var(--mute-on-paper-2); cursor: pointer; }
  .sdumb-sort button[aria-pressed='true'] { background: var(--ink-on-paper); color: var(--paper); }
  .sdumb-plot { position: relative; }
  .sdumb-plot :global(svg) { display: block; width: 100%; overflow: visible; }
  .sdumb-plot :global(text) { font-family: var(--font-mono); font-size: 11px; fill: var(--mute-on-paper-2); font-feature-settings: 'tnum' 1; }
  .sdumb-plot :global(.lab) { fill: var(--ink-on-paper); font-size: 12px; }
  .sdumb-plot :global(.chg) { fill: var(--ink-on-paper); }
  .sdumb-plot :global(.grid) { stroke: var(--line-on-paper-2); }
  .sdumb-plot :global(.link) { stroke: #d8cdb6; stroke-width: 3; }
  .sdumb-plot :global(.da) { fill: var(--dot-a); }
  .sdumb-plot :global(.db) { fill: var(--amber); }
  .sdumb-plot :global(.row) { transition: transform 0.35s ease; }
  .sdumb-plot :global(.hit) { fill: transparent; cursor: pointer; }
  .sdumb-plot :global(.row:hover .hit), .sdumb-plot :global(.hit:focus) { fill: rgba(0, 0, 0, 0.04); outline: none; }
  .sdumb-xlabel { font-size: 11px; color: var(--mute-on-paper-2); text-align: right; margin-top: 4px; }
  .sdumb-table { margin-top: 18px; border-collapse: collapse; font-size: 13px; font-feature-settings: 'tnum' 1; }
  .sdumb-table th { text-align: left; font-weight: 400; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase !important; color: var(--mute-on-paper-2); padding: 0 20px 6px 0; }
  .sdumb-table td { padding: 4px 20px 4px 0; border-top: 1px solid var(--line-on-paper-2); }
  .sdumb-tip {
    position: absolute; z-index: 5; pointer-events: none; background: var(--paper); border: 1px solid var(--ink-on-paper);
    padding: 8px 10px; font-size: 12px; line-height: 1.5; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08); white-space: pre;
  }
  .sdumb-tip[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .sdumb-plot :global(.row) { transition: none; } }
</style>

<script>
  const svgNS = 'http://www.w3.org/2000/svg';
  const el = (n: string, a: Record<string, string | number>, text?: string) => {
    const e = document.createElementNS(svgNS, n);
    for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
    if (text) e.textContent = text;
    return e;
  };
  type Row = { label: string; a: number; b: number; note?: string };
  document.querySelectorAll<HTMLElement>('.sdumb').forEach((fig) => {
    const rows = JSON.parse(fig.dataset.rows!) as Row[];
    const cases = JSON.parse(fig.dataset.cases!) as [string, string];
    const xu = fig.dataset.xunit ?? '';
    const box = fig.querySelector('.sdumb-plot') as HTMLElement;
    const tip = fig.querySelector('.sdumb-tip') as HTMLElement;
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('.sdumb-sort button')];
    const sd = (v: number) => `${v < 0 ? '−' : '+'}${Math.abs(v).toFixed(1)}`;
    let order = rows.map((_, i) => i);
    let groups: SVGGElement[] = [];
    const ROW = 30, TOP = 8, AX = 22;

    // css transform (not the svg attribute) so the re-sort animates
    const place = () => order.forEach((ri, pos) => { if (groups[ri]) groups[ri].style.transform = `translateY(${TOP + pos * ROW}px)`; });

    function draw() {
      const W = box.clientWidth, narrow = W < 520;
      const labW = narrow ? Math.min(150, W * 0.42) : 210, chgW = 44;
      const lo = Math.floor(Math.min(...rows.map((r) => Math.min(r.a, r.b))) / 10) * 10;
      const hi = Math.min(100, Math.ceil(Math.max(...rows.map((r) => Math.max(r.a, r.b))) / 10) * 10);
      const X = (v: number) => labW + ((v - lo) / (hi - lo)) * (W - labW - chgW);
      const H = TOP + rows.length * ROW + AX;
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, height: H });
      const step = hi - lo > 30 ? 10 : 5;
      for (let v = lo; v <= hi; v += step) {
        svg.appendChild(el('line', { class: 'grid', x1: X(v), x2: X(v), y1: TOP - 4, y2: H - AX }));
        svg.appendChild(el('text', { x: X(v), y: H - 6, 'text-anchor': 'middle' }, `${v}${v === hi ? ' ' + xu : ''}`));
      }
      groups = rows.map((r) => {
        const g = el('g', { class: 'row' }) as SVGGElement;
        const cy = ROW / 2;
        const label = narrow && r.label.length > 18 ? r.label.slice(0, 17) + '…' : r.label;
        g.appendChild(el('rect', { class: 'hit', x: 0, y: 0, width: W, height: ROW, tabindex: 0, 'aria-label': `${r.label}: ${r.a.toFixed(1)}${xu} → ${r.b.toFixed(1)}${xu}` }));
        g.appendChild(el('text', { class: 'lab', x: 0, y: cy + 4 }, label));
        g.appendChild(el('line', { class: 'link', x1: X(r.a), x2: X(r.b), y1: cy, y2: cy }));
        g.appendChild(el('circle', { class: 'da', cx: X(r.a), cy, r: 5.5 }));
        g.appendChild(el('circle', { class: 'db', cx: X(r.b), cy, r: 5.5 }));
        g.appendChild(el('text', { class: 'chg', x: Math.max(X(r.a), X(r.b)) + 10, y: cy + 4 }, sd(r.b - r.a)));
        const hit = g.firstChild as SVGRectElement;
        const text = [r.label, `${cases[0]}: ${r.a.toFixed(1)}${xu}`, `${cases[1]}: ${r.b.toFixed(1)}${xu}`, `${sd(r.b - r.a)} pts`, ...(r.note ? [r.note] : [])].join('\n');
        const show = (ev: { clientX: number; clientY: number }) => {
          tip.textContent = text; tip.hidden = false;
          const fb = fig.getBoundingClientRect();
          tip.style.left = `${Math.max(0, Math.min(ev.clientX - fb.left + 12, fb.width - tip.offsetWidth))}px`;
          tip.style.top = `${ev.clientY - fb.top - tip.offsetHeight - 12}px`;
        };
        hit.addEventListener('pointermove', (e) => show(e as PointerEvent));
        hit.addEventListener('focus', () => { const b = hit.getBoundingClientRect(); show({ clientX: b.left + labW, clientY: b.top }); });
        hit.addEventListener('pointerleave', () => (tip.hidden = true));
        hit.addEventListener('blur', () => (tip.hidden = true));
        svg.appendChild(g);
        return g;
      });
      box.replaceChildren(svg);
      place();
    }

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        order = rows.map((_, i) => i);
        if (btn.dataset.sort === 'change') order.sort((i, j) => (rows[j].b - rows[j].a) - (rows[i].b - rows[i].a));
        place();
      })
    );
    new ResizeObserver(draw).observe(box);
  });
</script>
