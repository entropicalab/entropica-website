---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getLocaleFromPath, alternateUrls } from '../i18n/utils';
import { lastmodForPath } from '../lib/lastmod.mjs';
import type { Locale } from '../i18n/strings';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
  noindex?: boolean;
  // bare: a standalone landing page. logo only in the header, a one-line
  // footer, no nav, no language toggle and no hreflang alternates, so the
  // visitor stays on the page (used by /en/specification-studies).
  bare?: boolean;
  bareDark?: boolean; // bare header on an ink band, white logo
}

const pathname = Astro.url.pathname;
const detectedLocale = getLocaleFromPath(pathname);
const {
  title,
  description = 'entrópica is an energy-led tropical architecture studio in panamá. we use climate science and building physics to design cool buildings in hot places.',
  locale = detectedLocale,
  ogImage = '/entropica-og-gradient.jpg',
  noindex = false,
  bare = false,
  bareDark = false,
} = Astro.props;

const fullTitle = title.includes('entrópica') ? title : `${title} · entrópica`;
// trailing slash: github pages serves /path/ and 301s /path, so canonical must match.
const canonical = new URL(pathname.endsWith('/') ? pathname : `${pathname}/`, Astro.site).toString();
// absolute url for the social-share image. default is the purpose-built
// 1200×630 branded card; the dimensions below let whatsapp, facebook and
// linkedin render the card without re-fetching.
const ogImageUrl = new URL(ogImage, Astro.site).toString();
// the width/height/type hints are only correct for the default 1200×630
// gradient; blog and project pages pass their own hero image (variable size,
// sometimes png), so emit the dimension hints only for the default.
const isDefaultOg = ogImage === '/entropica-og-gradient.jpg';

const lastmod = lastmodForPath(pathname);
const lastmodIso = lastmod.toISOString();
const lastmodLabel = new Intl.DateTimeFormat(locale === 'es' ? 'es-PA' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(lastmod);
const updatedText = locale === 'es' ? 'última actualización' : 'last updated';

// english-only since 2026-11-23 (rev 2, B4): no hreflang alternates. the two
// spanish panamá tools keep lang="es" because their text is spanish.
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    {/* material symbols outlined — weight 300 to match brand's light feel */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" />

    {/* opengraph + twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={fullTitle} />
    {isDefaultOg && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content={locale === 'es' ? 'es_PA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#f4f1ea" />

    {/* google analytics + consent mode v2. only renders if a real measurement id
        is set in src/config/analytics.ts. cookies stay denied until the visitor
        accepts via ConsentBanner below. */}
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    {bare ? (
      <header class={bareDark ? 'bare-header dark' : 'bare-header'}>
        <div class="site-wrap">
          <a href={pathname} aria-label="entrópica">
            <img src={bareDark ? '/entropica-white.png' : '/entropica-dark.png'} alt="entrópica" width="200" height="56" />
          </a>
        </div>
      </header>
    ) : (
      <Header locale={locale} pathname={pathname} />
    )}
    <main id="main">
      <slot />
    </main>
    {!bare && (
      <div class="page-updated">
        <div class="site-wrap">
          <time datetime={lastmodIso}>{updatedText}: {lastmodLabel}</time>
        </div>
      </div>
    )}
    {bare ? <slot name="footer" /> : <Footer locale={locale} />}
    <ConsentBanner locale={locale} />
  </body>
</html>

<style>
  .bare-header { padding: 28px 0; border-bottom: 1px solid var(--line-on-paper); }
  .bare-header img { height: 30px; width: auto; max-width: 100%; display: block; }
  @media (max-width: 520px) { .bare-header img { height: 22px; } }
  .bare-header.dark { background: var(--ink); border-bottom-color: var(--line); }
  .page-updated { padding: 14px 0 4px; }
  .page-updated time {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute-on-paper-2);
    font-weight: 400;
  }
</style>
