---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localized, tr } from '../i18n/utils';

const locale = 'es' as const;
const t = tr(locale);

const faqs = [
  {
    q: "¿por qué no le pongo aire acondicionado y ya?",
    a: "puedes, y es lo que hace casi todo el mundo. el costo llega en la factura, cada mes. si el edificio recibe menos calor, el equipo puede ser más pequeño y trabaja menos. según la onu, evitar que el calor entre puede bajar la temperatura interior entre 2 y 8 °C (unep, global cooling watch 2025).",
  },
  {
    q: "¿por qué se sube tanto la cuenta de luz en panamá?",
    a: "porque la tarifa residencial es progresiva: mientras más consumes en el mes, más caro sale cada kwh. los primeros 300 kwh rondan USD 0.091; de 301 a 750, cerca de 0.158; por encima de 750, cerca de 0.230. el aire acondicionado suele ser lo que te lleva al bloque caro.",
  },
  {
    q: "¿cuánto cuesta construir una casa en panamá en 2026?",
    a: "para una casa manejamos rangos de USD 370 a 500 por m² en acabado básico, 650 a 850 en estándar y 1,300 a 2,200 en premium. súmale cerca de 15% para diseño, permisos y legal. no incluye terreno, muebles ni el itbms. puedes probar tu caso en la calculadora de costos.",
  },
  {
    q: "¿cuánto se ahorra de verdad con diseño pasivo?",
    a: "depende del edificio, y por eso simulamos cada proyecto. como referencia, la onu reporta un ahorro promedio de 29% de energía con medidas de enfriamiento pasivo (unep, global cooling watch 2025). en panamá, la guía de construcción sostenible pide 20% de ahorro en edificios nuevos.",
  },
  {
    q: "¿conviene renovar o construir desde cero?",
    a: "depende del estado de la estructura. como punto de partida, el municipio de panamá usa USD 250 a 500 por m² para remodelar una casa, contra 650 a 850 para una nueva estándar. los honorarios van al revés: coici fija un mínimo de 2% para reformas y 1% para casa nueva, porque intervenir lo existente tiene más riesgo. la calculadora tiene un modo de renovación para comparar.",
  },
  {
    q: "¿qué necesito para empezar un proyecto con entrópica?",
    a: "una conversación sobre el lugar y lo que quieres construir. con eso arrancamos.",
  },
  {
    q: "¿dónde trabajan?",
    a: "diseñamos para cualquier lugar. los permisos los tramitamos solo en panamá.",
  },
  {
    q: "¿tramitan permisos de construcción?",
    a: "sí: anteproyecto, planos misceláneos y planos constructivos, en el municipio de panamá y en el resto del país.",
  },
  {
    q: "¿cuánto cuesta construir un edificio diseñado para el clima?",
    a: "depende del proyecto. revisamos con el cliente y el contratista todo lo que mueve el costo de obra, y nos enfocamos en bajar lo que el edificio gasta cada mes. para un rango de obra, usa la calculadora de costos.",
  },
  {
    q: "¿ayudan con certificaciones leed o edge?",
    a: "todavía no hemos llevado un proyecto a certificación leed o edge. conocemos el proceso y hacemos los estudios de energía y luz natural en los que se apoya, así que podemos trabajar junto al equipo que la tramite.",
  },
  {
    q: "¿hacen proyectos de interiores, o solo obra nueva?",
    a: "las dos cosas. en obra nueva todavía se puede decidir la forma del edificio. en una remodelación la fachada ya existe, y el trabajo es reorganizar por dentro para que sea más cómodo.",
  },
  {
    q: "¿qué es la arquitectura bioclimática y por qué importa en panamá?",
    a: "es diseñar con el clima: usar la orientación, la sombra, la ventilación y los materiales para que el edificio se mantenga fresco antes de encender el aire. en panamá, esas decisiones marcan cuánta energía gasta el edificio el resto de su vida.",
  },
  {
    q: "¿necesito tener el terreno antes de hablar con ustedes?",
    a: "no hace falta. si ya lo tienes, estudiamos el sol y el viento del sitio real. si todavía estás eligiendo, te ayudamos a comparar cómo le afectaría el clima a cada opción.",
  },
  {
    q: "¿trabajan con otras firmas de arquitectura?",
    a: "sí. parte de nuestro trabajo es asesorar a otras firmas y a fabricantes, con estudios de energía y luz natural para proyectos que ya tienen su equipo de diseño.",
  },
  {
    q: "¿en qué idiomas trabajan?",
    a: "español e inglés, en documentos y en reuniones.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="preguntas frecuentes · entrópica · arquitectos en panamá"
  description="preguntas frecuentes sobre entrópica: costos de construcción en panamá, la factura de luz, permisos municipales, remodelaciones y arquitectura bioclimática."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// preguntas frecuentes</div>
      <h1 class="hero-h">lo que suelen preguntarnos.</h1>
      <p class="hero-lede">
        si tu pregunta no está aquí, escríbenos.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="site-wrap">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <article class="faq-row">
            <div class="faq-ix">{String(i + 1).padStart(2, '0')}</div>
            <div class="faq-content">
              <h2 class="faq-q">{f.q}</h2>
              <p class="faq-a">{f.a}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="eyebrow">// ¿otra pregunta?</div>
        <h2 class="closing-h">cuéntanos del proyecto y del clima.</h2>
        <div class="closing-ctas">
          <a class="btn amber" href={localized('/contact', locale)}>
            {t('cta.contact')}
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 96px 0 56px; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 24px; font-weight: 400; }
  .hero-h { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 28px; font-weight: 300; max-width: 22ch; text-wrap: balance; }
  .hero-lede { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--mute-on-paper); max-width: 56ch; margin: 0; font-weight: 300; }

  .faq-section { padding: 24px 0 80px; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-row { display: grid; grid-template-columns: 80px 1fr; gap: 48px; padding: 40px 0; border-top: 1px solid var(--line-on-paper); align-items: start; }
  .faq-row:last-child { border-bottom: 1px solid var(--line-on-paper); }
  .faq-ix { font-size: 14px; color: var(--mute-on-paper-2); font-feature-settings: 'tnum' 1; letter-spacing: 0.10em; text-transform: uppercase; padding-top: 6px; }
  .faq-content { max-width: 64ch; display: flex; flex-direction: column; gap: 12px; }
  .faq-q { font-size: clamp(19px, 2vw, 23px); line-height: 1.2; letter-spacing: -0.015em; font-weight: 300; margin: 0; text-wrap: balance; }
  .faq-a { font-size: 15px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; margin: 0; }
  @media (max-width: 900px) { .faq-row { grid-template-columns: 1fr; gap: 12px; } }

  .closing-cta { padding: 96px 0; border-top: 1px solid var(--line-on-paper); }
  .closing-inner { max-width: 800px; }
  .closing-inner .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; font-weight: 400; }
  .closing-h { font-size: clamp(28px, 3.5vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 32px; font-weight: 300; text-wrap: balance; }
  .closing-ctas { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .contact-line { font-size: 14px; color: var(--mute-on-paper); border-bottom: 1px solid transparent; padding: 4px 0; }
  .contact-line:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>
