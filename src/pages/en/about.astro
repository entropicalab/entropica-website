---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LINKEDIN } from '../../data/business';

const locale = 'en' as const;

const work = [
  {
    role: 'partner',
    org: 'trimpacta',
    period: '2024-present',
    body: 'sustainability reports, water footprint and carbon for companies.',
  },
  {
    role: 'founder',
    org: 'entrópica',
    period: '2020-present',
    body: 'building-performance modeling: energy, daylight, thermal comfort, facade solar and airflow studies for consultancies and design teams.',
  },
  {
    role: 'co-founder',
    org: 'acta sustainable innovation zone',
    period: '2018-2021',
    body: 'sustainable urban planning and public space projects.',
  },
  {
    role: 'junior architect',
    org: 'erdy mchenry architecture · philadelphia, pa',
    period: '2017-2018',
    body: "design and environmental analysis for institutional and mixed-use buildings, such as the neptune building at vanguard's campus west.",
  },
  {
    role: 'co-founder · design principal',
    org: 'pentagrama',
    period: '2013-2016 · 2018-2023',
    body: 'led the design of residential, commercial and institutional projects, with their coordination and site supervision.',
  },
  {
    role: 'research intern',
    org: 'panamá green building council',
    period: '2013',
    body: 'research on sustainability and the first simulation tools in panamá.',
  },
];

const honors = [
  { year: '2024', name: 'dna paris design awards', detail: 'winner, cultural architecture: lotus hall by soba, with josé barría in the design team (energy and daylight strategy)', url: 'https://dna.paris/social/zoom.php?eid=71-91603-24' },
  { year: '2022', name: 'moa awards (premios moa)', detail: 'distinción de honor, 68th edition (colegio de arquitectos de panamá, spia): new headquarters of the ministerio público metropolitan unit', url: 'https://ministeriopublico.gob.pa/notas-de-prensa/la-procuraduria-general-de-la-nacion-recibe-distincion-de-honor-en-los-premios-moa-por-el-proyecto-de-la-nueva-sede-de-la-fiscalia-metropolitana/' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'josé barría',
  url: 'https://entropica-lab.com/en/about/',
  jobTitle: 'founder, lead modeler',
  sameAs: [LINKEDIN],
  hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'license', name: 'licensed architect (panamá)', identifier: '2015-001-042', recognizedBy: { '@type': 'Organization', name: 'junta técnica de ingeniería y arquitectura (JTIA)' } },
  worksFor: { '@type': 'Organization', name: 'entrópica', url: 'https://entropica-lab.com/en/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'university of pennsylvania' },
    { '@type': 'CollegeOrUniversity', name: 'isthmus', address: { '@type': 'PostalAddress', addressCountry: 'PA' } },
  ],
  knowsAbout: ['building energy modeling', 'daylight analysis', 'thermal comfort', 'CFD', 'EnergyPlus', 'Radiance', 'Ladybug Tools'],
};
---

<BaseLayout
  title="about · entrópica · building-performance modeling in panamá"
  description="entrópica is a building-performance modeling practice in panamá, led by josé barría: architect licensed in panamá (JTIA) and master of environmental building design (upenn)."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- ============ hero ============ -->
  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// about</div>
      <h1 class="hero-h">entrópica is a building-performance modeling practice in panamá.</h1>
      <p class="hero-lede">
        josé barría founded it and leads every study.
      </p>
    </div>
  </section>

  <!-- ============ portrait + bio ============ -->
  <section class="bio">
    <div class="site-wrap">
      <div class="bio-grid">
        <div class="portrait">
          <img src="/jose.jpg" alt="josé barría" />
          <div class="portrait-caption">
            <div class="eyebrow">// leadership</div>
            <div class="name">josé barría</div>
            <div class="role">founder · lead modeler</div>
          </div>
        </div>
        <div class="bio-text prose">
          <p class="lede">
            josé is an architect licensed in panamá (<span class="caps-in">JTIA</span>, license 2015-001-042) and the founder and lead modeler of entrópica.
          </p>
          <ul class="creds">
            <li>architect licensed in panamá</li>
            <li><span class="caps-in">M.EBD</span>, university of pennsylvania, 2017</li>
            <li>modeling building performance since 2020</li>
            <li>nine cities on five continents</li>
          </ul>
          <p>
            he has worked in panamá and the united states, and run studies for projects in
            asia, africa and europe. before entrópica he worked at erdy mchenry architecture
            in philadelphia, and co-founded pentagrama and acta. he researched at the panamá
            green building council and taught at the urban sustainable lab.
          </p>
          <p>
            he is also a partner at trimpacta, a water footprint and carbon consultancy.
          </p>
          <p>
            <a class="inline-link" href={LINKEDIN} target="_blank" rel="noopener">josé on linkedin</a>
          </p>

          <h2>education</h2>
          <ul>
            <li><b>master of environmental building design</b>, university of pennsylvania (2017)</li>
            <li><b>bachelor of architecture</b>, isthmus, panamá (2014)</li>
          </ul>

          <h2>honors</h2>
          <ul>
            {honors.map((h) => (
              <li>
                <b>{h.url ? <a href={h.url} target="_blank" rel="noopener">{h.name}</a> : h.name}</b>, {h.detail} <span class="muted">({h.year})</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ work history ============ -->
  <section class="block">
    <div class="site-wrap">
      <div class="proof-head">
        <div class="eyebrow">// background</div>
        <h2 class="block-h">where he has worked.</h2>
      </div>

      <div class="cv-stack">
        {work.map((w) => (
          <article class="cv-row">
            <div class="cv-period">{w.period}</div>
            <div class="cv-meta">
              <div class="cv-role">{w.role}</div>
              <div class="cv-org">{w.org}</div>
            </div>
            <div class="cv-body">{w.body}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ architecture archive (rev 2, B4: linked only from here) ============ -->
  <section class="block archive-line">
    <div class="site-wrap">
      <p>
        before modeling became the whole practice, josé designed buildings in panamá and abroad.
        <a class="inline-link" href="/en/architecture/">see the architecture archive</a>.
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <h2 class="closing-h">more projects than modelers?</h2>
        <div class="closing-ctas">
          <a class="btn amber" href="/en/contact/">
            send a project
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 64px;
  }
  .hero .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 400;
  }
  .hero-h {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    font-weight: 300;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero-lede {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--mute-on-paper);
    max-width: 64ch;
    margin: 0;
    font-weight: 300;
  }

  .bio {
    padding: 72px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  .bio-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 64px;
  }
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--paper-2);
    border: 1px solid var(--line-on-paper);
    display: block;
  }
  .portrait-caption {
    margin-top: 16px;
  }
  .portrait-caption .eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 6px;
  }
  .portrait-caption .name {
    font-size: 20px;
    letter-spacing: -0.01em;
    font-weight: 300;
  }
  .portrait-caption .role {
    font-size: 12px;
    color: var(--mute-on-paper);
    margin-top: 4px;
    font-weight: 300;
  }

  .bio-text {
    max-width: 64ch;
  }
  .bio-text .lede {
    font-size: 22px;
    line-height: 1.4;
    font-weight: 300;
    color: var(--ink-on-paper);
    margin-bottom: 24px;
  }
  .bio-text h2 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute-on-paper-2);
    font-weight: 400;
    margin-top: 40px;
    margin-bottom: 12px;
  }
  .caps-in { text-transform: none; }
  .creds { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .creds li::before { content: ''; display: inline-block; width: 8px; height: 8px; background: var(--amber); margin-right: 10px; }
  .archive-line p { margin: 0; font-size: 15px; color: var(--mute-on-paper); max-width: 64ch; }
  .bio-text .muted {
    color: var(--mute-on-paper);
  }

  @media (max-width: 900px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .portrait img {
      max-width: 360px;
    }
  }

  /* cv stack */
  .block {
    padding: 80px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  .block.alt {
    background: var(--paper-2);
  }
  .proof-head {
    margin-bottom: 48px;
  }
  .proof-head .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 16px;
  }
  .block-h {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 300;
    max-width: 24ch;
    text-wrap: balance;
  }
  .cv-stack {
    display: grid;
    gap: 0;
  }
  .cv-row {
    display: grid;
    grid-template-columns: 180px 280px 1fr;
    gap: 32px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  /* no border-bottom on last cv-row, the following .block adds its own border-top */
  .cv-period {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute-on-paper-2);
    font-weight: 400;
  }
  .cv-role {
    font-size: 16px;
    font-weight: 400;
  }
  .cv-org {
    font-size: 12px;
    color: var(--mute-on-paper);
    margin-top: 4px;
    font-weight: 300;
  }
  .cv-body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--mute-on-paper);
    font-weight: 300;
    max-width: 52ch;
  }
  @media (max-width: 900px) {
    .cv-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .philosophy-grid > div .eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 10px;
  }
  .phil-h {
    font-size: 19px;
    font-weight: 400;
    margin: 0 0 8px;
  }
  .phil-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--mute-on-paper);
    font-weight: 300;
    margin: 0;
  }
  @media (max-width: 900px) {
    .philosophy-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 540px) {
    .philosophy-grid {
      grid-template-columns: 1fr;
    }
  }

  .closing-cta {
    padding: 96px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  .closing-inner {
    max-width: 800px;
  }
  .closing-h {
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    font-weight: 300;
    text-wrap: balance;
  }
  .closing-ctas {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .contact-line {
    font-size: 14px;
    color: var(--mute-on-paper);
    border-bottom: 1px solid transparent;
    padding: 4px 0;
  }
  .contact-line:hover {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }
</style>
