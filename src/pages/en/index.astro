---
// /en/ · the front door. since the 2026-11-23 pivot (rev 2, part B1) the home
// page sells one thing: building-performance modeling for consultancies and
// design teams. it reuses the modeling-support blocks, so the email, the
// landing page and the home page say the same thing.
//
// manufacturers: no link to /en/specification-studies/ until saint-gobain
// gives written clearance. after that, add a second card "for building-product
// manufacturers".
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClientBand from '../../components/ClientBand.astro';
import TowerSheet from '../../components/TowerSheet.astro';
import ResultCards from '../../components/ResultCards.astro';
import WhoDoesTheWork from '../../components/WhoDoesTheWork.astro';
import { results } from '../../data/studies';
import { business } from '../../data/business';
import '../../styles/study-page.css';

const locale = 'en' as const;

// three cards: the tower sample, and two real client projects (l12, casa castillo).
const picks = ['glazing', 'glass selection', 'roof shading'];
const homeResults = picks.map((c) => results.find((r) => r.cat === c)!);

const MS = '/en/modeling-support/';
---

<BaseLayout
  title="building-performance modeling for consultancies and design teams · entrópica"
  description="energy, daylight and comfort simulations for consultancies and design teams. entrópica builds and runs the models, checks every number, and delivers in your format."
  locale={locale}
  ogImage="/og-modeling-support.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(business('https://entropica-lab.com/en/'))} />

  <!-- 1 · hero -->
  <section class="hero" id="hero">
    <div class="site-wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">building-performance modeling · panamá · <span class="caps">UTC−5</span></p>
        <h1>energy, daylight and comfort simulations for consultancies and design teams.</h1>
        <p class="lede">
          entrópica builds and runs the models, checks every number, and delivers in
          your format, typically in 5 business days.
        </p>
        <div class="ctas">
          <a class="btn amber" href={`${MS}#start`}>send a project <span class="arrow-tail" aria-hidden="true"></span></a>
          <a class="btn ghost" href={`${MS}#results`}>see sample results</a>
        </div>
      </div>
      <TowerSheet />
    </div>
  </section>

  <!-- 2 · clients -->
  <section class="clients-band" aria-label="clients">
    <div class="site-wrap"><ClientBand /></div>
  </section>

  <!-- 3 · results -->
  <section class="band tint">
    <div class="site-wrap">
      <p class="kicker">results from past studies</p>
      <h2>the kind of answer you get back.</h2>
      <ResultCards results={homeResults} />
      <p class="more"><a href={`${MS}#results`}>more results, and how a job works <span class="arrow-tail" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <!-- 4 · who does the work -->
  <section class="band">
    <div class="site-wrap">
      <WhoDoesTheWork />
    </div>
  </section>

  <!-- 5 · close -->
  <section class="band dark close-home">
    <div class="site-wrap">
      <h2>more projects than modelers?</h2>
      <div class="ctas">
        <a class="btn amber" href={`${MS}#start`}>send a project <span class="arrow-tail" aria-hidden="true"></span></a>
        <a class="mail" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* the home h1 is a full sentence, so it runs smaller than modeling support's */
  .hero h1 { font-size: clamp(30px, 3.6vw, 50px); line-height: 1.08; max-width: 20ch; }
  .more { margin: 32px 0 0; font-size: 15px; }
  .more a { color: var(--ink-on-paper); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .more a:hover { color: var(--amber); }
  .close-home h2 { margin-bottom: 28px; }
  .close-home .ctas { align-items: center; gap: 16px 28px; margin-bottom: 0; }
  .mail { color: var(--mute); font-size: 14px; border-bottom: 1px solid transparent; }
  .mail:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>
