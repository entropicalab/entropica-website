---
// /en/modeling-support/ forwards to /en/ (2026-11-24: the modeling support
// page became the home page). a hand-made forward instead of an astro
// redirect, because the script keeps the #fragment: links already sent to
// .../modeling-support/#start still land on the intake. the meta refresh is
// the fallback without javascript. out of the sitemap (astro.config.mjs).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>entrópica</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://entropica-lab.com/en/" />
    <script is:inline>location.replace('/en/' + location.hash);</script>
    <meta http-equiv="refresh" content="0; url=/en/" />
  </head>
  <body>
    <a href="/en/">entropica-lab.com</a>
  </body>
</html>
