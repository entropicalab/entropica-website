---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localized, tr } from '../../i18n/utils';

const locale = 'en' as const;
const t = tr(locale);

const services = [
  {
    n: '01',
    icon: 'architecture',
    title: 'concept design',
    short: 'we decide which way the building faces, how much glass it has and where the shade goes, with your site\'s climate. this is where most of the savings come from.',
    body: '',
    deliverables: ['massing options tested against the site\'s climate', 'the program arranged by the sun', 'a realistic energy target'],
  },
  {
    n: '02',
    icon: 'dashboard_customize',
    title: 'full design',
    short: 'the construction drawings, with materials and systems defined and coordinated with the structural, electrical, plumbing and mechanical engineers.',
    body: '',
    deliverables: ['drawings and specifications', 'materials and systems defined', 'coordination meetings with the engineers'],
  },
  {
    n: '03',
    icon: 'description',
    title: 'permits and drawings',
    short: 'preliminary designs and drawings that pass review in the municipality of panamá and across the country. josé barría has been getting them approved for more than ten years.',
    body: '',
    deliverables: ['preliminary design (anteproyecto) for municipal review', 'miscellaneous and construction drawings', 'filing in the municipality of panamá and nationwide'],
  },
  {
    n: '04',
    icon: 'monitoring',
    title: 'energy studies',
    short: 'we answer concrete questions with numbers: whether to make a window bigger, or whether a better-insulated facade pays for itself. it also helps if your project is going for leed or edge.',
    body: 'in panamá, new buildings must save 15% of energy against a baseline, and 20% after the first two years (resolution 3980 of 2018, per the panamá green building council, 2026).',
    deliverables: ['sun, daylight and energy simulations', 'clear answers to design questions'],
  },
];
---

<BaseLayout
  title="architects in panama · architecture and energy services"
  description="an architecture studio in the republic of panamá, central america: concept design, documentation and coordination, permitting (jtia, mupa), and energy and performance advisory."
  locale={locale}
>
  <!-- hero -->
  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// services</div>
      <h1 class="hero-h">from the first sketch to the permit.</h1>
      <p class="hero-lede">
        we design your project, coordinate it with the engineers and take it through to
        the permit. the climate goes into every decision.
      </p>
    </div>
  </section>

  <!-- services list -->
  <section class="services-section">
    <div class="site-wrap">
      <div class="services-list">
        {services.map((s) => (
          <article class="service-row">
            <div class="svc-n">
              <span class="material-symbols-outlined icon-md icon-amber svc-icon">{s.icon}</span>
              <span class="svc-num">{s.n}</span>
            </div>
            <div class="svc-title">{s.title}</div>
            <div class="svc-content">
              <p class="svc-short">{s.short}</p>
              {s.body && <p class="svc-body">{s.body}</p>}
              <div class="svc-deliverables">
                <div class="dv-eb">// includes</div>
                <ul>
                  {s.deliverables.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- architecture + interiors -->
  <section class="block">
    <div class="site-wrap">
      <div class="two-col">
        <div class="col-eb"><div class="eyebrow">// new build or renovation</div></div>
        <div class="col-body">
          <h2 class="block-h">we also work with what is already there.</h2>
          <div class="prose">
            <p>
              in a renovation the facade is already built. the work is to rearrange spaces
              and systems so the place feels cooler.
              <a class="inline-link" href={localized('/projects/current-technologies', locale)}>current technologies</a>
              is an example.
            </p>
            <p>
              questions about scope or permits? see the
              <a class="inline-link" href={localized('/faq', locale)}>faq</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- closing CTA -->
  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <h2 class="closing-h">building or renovating?</h2>
        <div class="closing-ctas">
          <a class="btn amber" href={localized('/contact', locale)}>
            tell us about your project
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 64px;
  }
  .hero .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 400;
  }
  .hero-h {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    font-weight: 300;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero-lede {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--mute-on-paper);
    max-width: 60ch;
    margin: 0;
    font-weight: 300;
  }

  .services-section {
    padding: 24px 0 80px;
  }
  .services-list {
    display: flex;
    flex-direction: column;
  }
  .service-row {
    display: grid;
    grid-template-columns: 80px 260px 1fr;
    gap: 48px;
    padding: 48px 0;
    border-top: 1px solid var(--line-on-paper);
    align-items: start;
  }
  .service-row:last-child {
    border-bottom: 1px solid var(--line-on-paper);
  }
  .svc-n {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .svc-n .svc-num {
    font-size: 32px;
    color: var(--mute-on-paper-2);
    font-feature-settings: 'tnum' 1;
    letter-spacing: -0.02em;
    font-weight: 300;
    line-height: 1;
  }
  .svc-n .svc-icon {
    display: block;
  }
  .svc-title {
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-weight: 300;
  }
  .svc-content {
    max-width: 56ch;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .svc-short {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-on-paper);
    font-weight: 300;
    margin: 0;
  }
  .svc-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--mute-on-paper);
    font-weight: 300;
    margin: 0;
  }
  .svc-deliverables {
    margin-top: 8px;
  }
  .dv-eb {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute-on-paper-2);
    font-weight: 400;
    margin-bottom: 8px;
  }
  .svc-deliverables ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--mute-on-paper);
    font-weight: 300;
  }
  .svc-deliverables li::before {
    content: '› ';
    color: var(--amber);
    margin-right: 4px;
  }

  @media (max-width: 900px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .svc-n {
      font-size: 22px;
    }
  }

  .block {
    padding: 80px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  .block.alt {
    background: var(--paper-2);
  }
  .proof-head {
    margin-bottom: 48px;
  }
  .proof-head .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 16px;
  }
  .block-h {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    font-weight: 300;
    max-width: 26ch;
    text-wrap: balance;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .problem {
    padding: 24px 28px;
    background: var(--paper);
    border: 1px solid var(--line-on-paper);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .prob-name {
    font-size: 16px;
    font-weight: 400;
    color: var(--ink-on-paper);
  }
  .prob-soln {
    font-size: 14px;
    color: var(--mute-on-paper);
    line-height: 1.6;
    font-weight: 300;
  }
  @media (max-width: 700px) {
    .problems-grid {
      grid-template-columns: 1fr;
    }
  }

  .two-col {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 80px;
  }
  .col-eb .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    padding-top: 4px;
  }
  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .closing-cta {
    padding: 96px 0;
    border-top: 1px solid var(--line-on-paper);
  }
  .closing-inner {
    max-width: 800px;
  }
  .closing-inner .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-weight: 400;
  }
  .closing-h {
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    font-weight: 300;
    text-wrap: balance;
  }
  .closing-ctas {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .contact-line {
    font-size: 14px;
    color: var(--mute-on-paper);
    border-bottom: 1px solid transparent;
    padding: 4px 0;
  }
  .contact-line:hover {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }
</style>
