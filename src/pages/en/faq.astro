---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localized, tr } from '../../i18n/utils';

const locale = 'en' as const;
const t = tr(locale);

const faqs = [
  {
    q: "why not just install ac and be done with it?",
    a: "you can, and almost everybody does. the cost arrives on the bill, every month. if the building takes in less heat, the equipment can be smaller and it works less. according to the un, keeping heat out of a building can lower indoor temperatures by 2 to 8 °C (unep, global cooling watch 2025).",
  },
  {
    q: "why does the electricity bill climb so fast in panamá?",
    a: "because the residential tariff is progressive: the more you use in a month, the more each kwh costs. the first 300 kwh run around USD 0.091; from 301 to 750, about 0.158; above 750, about 0.230. air-conditioning is usually what pushes you into the expensive block.",
  },
  {
    q: "how much does it cost to build a house in panamá in 2026?",
    a: "for a house we work with ranges of USD 370 to 500 per m² at a basic finish, 650 to 850 at standard and 1,300 to 2,200 at premium. add about 15% for design, permits and legal. it excludes land, furniture and itbms. you can try your own case in the cost calculator.",
  },
  {
    q: "how much does passive design actually save?",
    a: "it depends on the building, which is why we simulate each project. as a reference, the un reports average energy savings of 29% from passive cooling measures (unep, global cooling watch 2025). in panamá, the sustainable building guide asks new buildings to save 20%.",
  },
  {
    q: "is it better to renovate or build from scratch?",
    a: "it depends on the state of the structure. as a starting point, the municipality of panamá uses USD 250 to 500 per m² to renovate a house, against 650 to 850 for a standard new one. fees go the other way: coici sets a minimum of 2% for renovations and 1% for a new house, because working on what already exists carries more risk. the calculator has a renovation mode to compare.",
  },
  {
    q: "what do i need to start a project with entrópica?",
    a: "a conversation about the place and what you want to build. that's enough to begin.",
  },
  {
    q: "where do you work?",
    a: "we design for anywhere. permits we handle in panamá only.",
  },
  {
    q: "do you handle building permits?",
    a: "yes: preliminary designs, miscellaneous drawings and construction documents, in the municipality of panamá and the rest of the country.",
  },
  {
    q: "how much does it cost to build a climate-led building?",
    a: "it depends on the project. we go through everything that moves the construction cost with the client and the contractor, and we focus on lowering what the building spends every month. for a construction range, use the cost calculator.",
  },
  {
    q: "do you help with leed or edge certification?",
    a: "we haven't taken a project through leed or edge certification yet. we know the process and we do the energy and daylight studies it relies on, so we can work alongside the team that handles it.",
  },
  {
    q: "do you do interior projects, or only new builds?",
    a: "both. in a new build the shape of the building is still open. in a renovation the facade already exists, and the work is rearranging the inside so it's more comfortable.",
  },
  {
    q: "what is bioclimatic architecture, and why does it matter in panamá?",
    a: "it means designing with the climate: using orientation, shade, ventilation and materials so the building stays cool before the ac goes on. in panamá, those decisions set how much energy the building uses for the rest of its life.",
  },
  {
    q: "do i need to own the land before talking to you?",
    a: "no. if you already have it, we study the sun and wind on the real site. if you're still choosing, we help you compare how the climate would affect each option.",
  },
  {
    q: "do you work with other architecture firms?",
    a: "yes. part of our work is advising other firms and manufacturers, with energy and daylight studies for projects that already have a design team.",
  },
  {
    q: "what languages do you work in?",
    a: "spanish and english, in documents and in meetings.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="frequently asked questions · entrópica · architects in panamá"
  description="frequently asked questions about entrópica: construction costs in panamá, the electricity bill, municipal permits, renovations and bioclimatic architecture."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// frequently asked</div>
      <h1 class="hero-h">what people usually ask.</h1>
      <p class="hero-lede">
        if your question isn't here, write to us.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="site-wrap">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <article class="faq-row">
            <div class="faq-ix">{String(i + 1).padStart(2, '0')}</div>
            <div class="faq-content">
              <h2 class="faq-q">{f.q}</h2>
              <p class="faq-a">{f.a}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="eyebrow">// another question?</div>
        <h2 class="closing-h">tell us about the project and the climate.</h2>
        <div class="closing-ctas">
          <a class="btn amber" href={localized('/contact', locale)}>
            {t('cta.contact')}
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 96px 0 56px; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 24px; font-weight: 400; }
  .hero-h { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 28px; font-weight: 300; max-width: 22ch; text-wrap: balance; }
  .hero-lede { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--mute-on-paper); max-width: 56ch; margin: 0; font-weight: 300; }

  .faq-section { padding: 24px 0 80px; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-row { display: grid; grid-template-columns: 80px 1fr; gap: 48px; padding: 40px 0; border-top: 1px solid var(--line-on-paper); align-items: start; }
  .faq-row:last-child { border-bottom: 1px solid var(--line-on-paper); }
  .faq-ix { font-size: 14px; color: var(--mute-on-paper-2); font-feature-settings: 'tnum' 1; letter-spacing: 0.10em; text-transform: uppercase; padding-top: 6px; }
  .faq-content { max-width: 64ch; display: flex; flex-direction: column; gap: 12px; }
  .faq-q { font-size: clamp(19px, 2vw, 23px); line-height: 1.2; letter-spacing: -0.015em; font-weight: 300; margin: 0; text-wrap: balance; }
  .faq-a { font-size: 15px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; margin: 0; }
  @media (max-width: 900px) { .faq-row { grid-template-columns: 1fr; gap: 12px; } }

  .closing-cta { padding: 96px 0; border-top: 1px solid var(--line-on-paper); }
  .closing-inner { max-width: 800px; }
  .closing-inner .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; font-weight: 400; }
  .closing-h { font-size: clamp(28px, 3.5vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 32px; font-weight: 300; text-wrap: balance; }
  .closing-ctas { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .contact-line { font-size: 14px; color: var(--mute-on-paper); border-bottom: 1px solid transparent; padding: 4px 0; }
  .contact-line:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>
