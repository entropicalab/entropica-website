---
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en' as const;

// rewritten 2026-11-23 for the pivot, in plain words for a reader who has
// never seen the home page. every fact matches /en/ or /en/about/. never
// "engineering". 2026-11-24: LEED answer, models stay with entrópica, and
// white-label without "client", from the home page copy doc.
// LEED / compliance: jose can do them but has not delivered one for a client
// yet (jose, 2026-11-23). say exactly that, never imply past LEED work.
// approved by jose 2026-11-23: indexed, in the sitemap, linked from the
// footer and the home page.
const faqs = [
  {
    q: 'what does entrópica do?',
    a: 'we run computer simulations of buildings: how much energy they use, how much daylight gets in, and how comfortable people feel inside. design teams and consultancies send us their projects when they need those answers.',
  },
  {
    q: 'who does the work?',
    a: 'josé barría. he’s an architect licensed in panamá, with a master’s in environmental building design from the university of pennsylvania, and he has modeled buildings since 2020. he builds or checks every model himself.',
  },
  {
    q: 'what kind of questions can you answer?',
    a: 'which glass keeps the building cooler. how deep the shading should be. how big the cooling system needs to be. whether a room gets enough daylight, or a terrace is comfortable in the afternoon. we can also show how wind moves around and through a building.',
  },
  {
    q: 'can you do LEED or code compliance models?',
    a: 'yes. we build energy models to ASHRAE 90.1 Appendix G and LEED daylight models (sDA and ASE). we haven’t delivered one for a client yet, so we agree the rules and your review steps with you before we quote.',
  },
  {
    q: 'what software do you use?',
    a: 'energyplus for energy, radiance for daylight and sun, ladybug tools inside rhino and grasshopper, climatestudio, and openfoam for wind. if your team works in ladybug tools, we can also fix or review your own models.',
  },
  {
    q: 'what do you need from us?',
    a: 'the drawings you have (a simple massing model is enough), the question you want answered, and your deadline. if you have a report template, send that too.',
  },
  {
    q: 'what do we get back?',
    a: 'the numbers in a spreadsheet, charts ready for your slides, a short note on how the model was set up, and the answer in one plain sentence.',
  },
  {
    q: 'how long does it take?',
    a: 'typically 5 business days for one question. bigger jobs get their schedule with the quote.',
  },
  {
    q: 'how much does it cost?',
    a: 'from USD 800 for one question on one building, comparing up to three options. you get a fixed price before any work starts.',
  },
  {
    q: 'we have more projects than people. can you help every month?',
    a: 'yes. send the month’s projects and deadlines, and we quote one fixed price for all of them. if you’re hiring a modeler, we can cover your projects until that person starts.',
  },
  {
    q: 'can the work go out under our name?',
    a: 'yes, if you want. we use your templates and report format.',
  },
  {
    q: 'are our files safe with you?',
    a: 'we sign an NDA before you send anything, if you need one. your models and data are never used on another project. the models stay with entrópica; you review them with josé on a call.',
  },
  {
    q: 'how do you know the numbers are right?',
    a: 'every result is compared with a clear starting point, so you know what it beats. before any chart is made, josé checks that the numbers make physical sense, and he reviews every study before it goes out.',
  },
  {
    q: 'do you work with teams outside panamá?',
    a: 'yes, all the work is remote. panamá never changes its clocks: it’s on new york time in winter and chicago time in summer.',
  },
  {
    q: 'what languages do you work in?',
    a: 'english and spanish.',
  },
];

// acronyms keep their capitals (global css lowercases text).
const ACR = /\b(LEED|USD|NDA|ASHRAE 90\.1 Appendix G|sDA|ASE)\b/g;
const caps = (t: string) => t.replace(ACR, '<span class="caps-in">$1</span>');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="questions · entrópica · building-performance modeling"
  description="how entrópica's building simulations work: who does them, what they answer, what you send, what you get back, how long they take and what they cost."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// frequently asked</div>
      <h1 class="hero-h">common questions.</h1>
      <p class="hero-lede">
        if yours isn’t here, write to josé.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="site-wrap">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <article class="faq-row">
            <div class="faq-ix">{String(i + 1).padStart(2, '0')}</div>
            <div class="faq-content">
              <h2 class="faq-q" set:html={caps(f.q)} />
              <p class="faq-a" set:html={caps(f.a)} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="eyebrow">// start a project</div>
        <h2 class="closing-h">send the project. get a fixed quote.</h2>
        <div class="closing-ctas">
          <a class="btn amber" href="/en/contact/">
            send a project
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 96px 0 56px; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 24px; font-weight: 400; }
  .hero-h { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 28px; font-weight: 300; max-width: 22ch; text-wrap: balance; }
  .hero-lede { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--mute-on-paper); max-width: 56ch; margin: 0; font-weight: 300; }

  .faq-section { padding: 24px 0 80px; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-row { display: grid; grid-template-columns: 80px 1fr; gap: 48px; padding: 40px 0; border-top: 1px solid var(--line-on-paper); align-items: start; }
  .faq-row:last-child { border-bottom: 1px solid var(--line-on-paper); }
  .faq-ix { font-size: 14px; color: var(--mute-on-paper-2); font-feature-settings: 'tnum' 1; letter-spacing: 0.10em; text-transform: uppercase; padding-top: 6px; }
  .faq-content { max-width: 64ch; display: flex; flex-direction: column; gap: 12px; }
  .faq-q { font-size: clamp(19px, 2vw, 23px); line-height: 1.2; letter-spacing: -0.015em; font-weight: 300; margin: 0; text-wrap: balance; }
  .faq-q :global(.caps-in), .faq-a :global(.caps-in) { text-transform: none; }
  .faq-a { font-size: 15px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; margin: 0; }
  @media (max-width: 900px) { .faq-row { grid-template-columns: 1fr; gap: 12px; } }

  .closing-cta { padding: 96px 0; border-top: 1px solid var(--line-on-paper); }
  .closing-inner { max-width: 800px; }
  .closing-inner .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; font-weight: 400; }
  .closing-h { font-size: clamp(28px, 3.5vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 32px; font-weight: 300; text-wrap: balance; }
  .closing-ctas { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .contact-line { font-size: 14px; color: var(--mute-on-paper); border-bottom: 1px solid transparent; padding: 4px 0; }
  .contact-line:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>
