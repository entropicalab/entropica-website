---
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en' as const;

// rewritten 2026-11-23 for the pivot: modeling support questions only.
// every answer repeats a fact already on /en/modeling-support/ or /en/about/.
// no LEED, compliance, certification, payback or "engineering" (claim rules).
// noindex until jose approves the copy; then remove noindex, drop the faq
// line from the sitemap filter in astro.config.mjs, and link it.
const faqs = [
  {
    q: 'what does entrópica do?',
    a: 'it builds and runs energy, daylight, thermal comfort, facade solar and airflow simulations for consultancies, facade consultants and architecture firms, and delivers checked results in your format.',
  },
  {
    q: 'who builds the models?',
    a: 'josé barría, founder and lead modeler. he is an architect licensed in panamá, with a master’s in environmental building design from the university of pennsylvania (2017), and has modeled building performance since 2020. he builds or checks every model himself.',
  },
  {
    q: 'what can a study model?',
    a: 'annual energy use, peak cooling load and chiller size. solar radiation on facades and roofs. annual illuminance, useful daylight hours, sDA and ASE. indoor pmv (ashrae 55) and outdoor utci. wind and air movement with CFD. and facade options (glass types, louvers, screens, overhangs) compared against one fair baseline.',
  },
  {
    q: 'which software do you use?',
    a: 'rhino and grasshopper, ladybug tools, energyplus (8,760 hours), radiance, climatestudio, and butterfly with openfoam for airflow.',
  },
  {
    q: 'what do you need from us to start?',
    a: 'the drawings you have (plans, elevations or a massing model), the question, the deadline, and your report template if you have one.',
  },
  {
    q: 'what do we get back?',
    a: 'a results spreadsheet, charts at final size, a short method note, and the result in one plain sentence, in your format.',
  },
  {
    q: 'how long does a study take?',
    a: 'typically 5 business days for a one-question study. larger scopes get their schedule with the quote.',
  },
  {
    q: 'how much does a study cost?',
    a: 'from USD 800 for a one-question study: one building, one question, up to three options against one baseline. every study gets a fixed-fee quote before any work starts.',
  },
  {
    q: 'can you take ongoing work?',
    a: 'yes. send the list of projects and deadlines for the month, and josé quotes a fixed fee for the block. if you are hiring an energy modeler, entrópica can cover your projects while you hire.',
  },
  {
    q: 'can you work under our name?',
    a: 'yes, on request. entrópica works in your templates, report format and QA rules. you keep the client relationship.',
  },
  {
    q: 'how do you handle confidential projects?',
    a: 'NDA before file transfer, on request. models and data from one project are never reused for another.',
  },
  {
    q: 'how is every result checked?',
    a: 'every result names its baseline. the weather file, schedules, set points and materials go in the method note. loads, temperatures and hours are checked against what the building can physically do before any chart is made. josé reviews every study before delivery.',
  },
  {
    q: 'we run our own models. can you help with them?',
    a: 'yes. entrópica builds, fixes and reviews grasshopper and honeybee definitions for teams that work in ladybug tools.',
  },
  {
    q: 'do you work with teams outside panamá?',
    a: 'yes. the work is remote. entrópica is on UTC−5 all year with no daylight saving change, so the day overlaps north and south american business hours. josé has modeled buildings in nine cities on five continents.',
  },
  {
    q: 'what languages do you work in?',
    a: 'english and spanish.',
  },
];

// acronyms keep their capitals (global css lowercases text).
const ACR = /\b(sDA|ASE|CFD|USD|NDA|QA|UTC−5)/g;
const caps = (t: string) => t.replace(ACR, '<span class="caps-in">$1</span>');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="questions · entrópica · building-performance modeling"
  description="how entrópica's modeling support works: what a study can model, the software, what you send, what you get back, turnaround, price, white-label and confidentiality."
  locale={locale}
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// frequently asked</div>
      <h1 class="hero-h">questions about modeling support.</h1>
      <p class="hero-lede">
        if yours isn’t here, write to josé.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="site-wrap">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <article class="faq-row">
            <div class="faq-ix">{String(i + 1).padStart(2, '0')}</div>
            <div class="faq-content">
              <h2 class="faq-q">{f.q}</h2>
              <p class="faq-a" set:html={caps(f.a)} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="eyebrow">// start a project</div>
        <h2 class="closing-h">send the project. get a fixed quote.</h2>
        <div class="closing-ctas">
          <a class="btn amber" href="/en/modeling-support/#start">
            send a project
            <span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 96px 0 56px; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 24px; font-weight: 400; }
  .hero-h { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 28px; font-weight: 300; max-width: 22ch; text-wrap: balance; }
  .hero-lede { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--mute-on-paper); max-width: 56ch; margin: 0; font-weight: 300; }

  .faq-section { padding: 24px 0 80px; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-row { display: grid; grid-template-columns: 80px 1fr; gap: 48px; padding: 40px 0; border-top: 1px solid var(--line-on-paper); align-items: start; }
  .faq-row:last-child { border-bottom: 1px solid var(--line-on-paper); }
  .faq-ix { font-size: 14px; color: var(--mute-on-paper-2); font-feature-settings: 'tnum' 1; letter-spacing: 0.10em; text-transform: uppercase; padding-top: 6px; }
  .faq-content { max-width: 64ch; display: flex; flex-direction: column; gap: 12px; }
  .faq-q { font-size: clamp(19px, 2vw, 23px); line-height: 1.2; letter-spacing: -0.015em; font-weight: 300; margin: 0; text-wrap: balance; }
  .faq-a :global(.caps-in) { text-transform: none; }
  .faq-a { font-size: 15px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; margin: 0; }
  @media (max-width: 900px) { .faq-row { grid-template-columns: 1fr; gap: 12px; } }

  .closing-cta { padding: 96px 0; border-top: 1px solid var(--line-on-paper); }
  .closing-inner { max-width: 800px; }
  .closing-inner .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; font-weight: 400; }
  .closing-h { font-size: clamp(28px, 3.5vw, 44px); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 32px; font-weight: 300; text-wrap: balance; }
  .closing-ctas { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .contact-line { font-size: 14px; color: var(--mute-on-paper); border-bottom: 1px solid transparent; padding: 4px 0; }
  .contact-line:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>
