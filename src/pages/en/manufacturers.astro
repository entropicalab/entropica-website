---
// manufacturer landing page. built from "261115 entrópica, manufacturer
// landing page · build spec". english only, no spanish mirror, no site nav:
// the outbound email links here and the page has one job.
// visual first (jose, 2026-11-15): one picture and one number per section.
// every figure on this page comes from a published study or the tornillo
// sample study export (C:\Entropica\047-ElTornillo\sim_export\tor_cases.csv).
// check it there before changing it. glass is named by type only.
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en' as const;

// formspree form id for info@entropica-lab.com (same endpoint as /contact).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';
const EMAIL = 'info@entropica-lab.com';

// fill these when they exist. while empty, the page falls back honestly:
// the sample report is offered on request, and the call is booked by email.
const SAMPLE_REPORT_URL = ''; // e.g. '/manufacturers/sample-report.pdf'
const BOOKING_URL = ''; // e.g. a cal.com or calendly link
const hasSample = SAMPLE_REPORT_URL !== '';

// ---- hero: the sample-study tower, drawn from its real geometry ----------
// 30 typical floors, plate 26.94 m square, 4.04 m floor to floor, 8.18° twist
// per floor, counterclockwise going up. floors 10, 14 and 17 were simulated.
const FLOORS = 30;
const HALF = 26.94 / 2;
const STEP = 4.04;
const TWIST = (8.18 * Math.PI) / 180;
const SIMULATED = [10, 14, 17];
const C30 = Math.cos(Math.PI / 6);
const S30 = Math.sin(Math.PI / 6);
const plates = Array.from({ length: FLOORS }, (_, i) => {
  const a = i * TWIST;
  const z = i * STEP;
  const pts = [
    [-HALF, -HALF],
    [HALF, -HALF],
    [HALF, HALF],
    [-HALF, HALF],
  ].map(([x, y]) => {
    const rx = x * Math.cos(a) - y * Math.sin(a);
    const ry = x * Math.sin(a) + y * Math.cos(a);
    return [(rx - ry) * C30, (rx + ry) * S30 - z];
  });
  return {
    i,
    sim: SIMULATED.includes(i + 1),
    points: pts.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' '),
  };
});
const towerTop = -(FLOORS - 1) * STEP - HALF * 1.45;
const towerBox = `${(-HALF * 1.45).toFixed(1)} ${towerTop.toFixed(1)} ${(HALF * 2.9).toFixed(1)} ${(-towerTop + HALF * 1.45).toFixed(1)}`;

// ---- one tile per product category ---------------------------------------
// a = before, b = after, same unit. change is rounded from a and b.
const tiles = [
  {
    cat: 'glazing',
    num: '−37%',
    what: 'a/c electricity, single clear to double reflective glass',
    a: { l: 'single clear', v: 113.5 },
    b: { l: 'double reflective', v: 71.4 },
    unit: 'kWh/m² a year',
    src: 'office tower, sample study',
  },
  {
    cat: 'dynamic glass',
    num: '−40%',
    what: 'working hours too warm at a desk 1 m from the glass',
    a: { l: 'double reflective', v: 29.4 },
    b: { l: 'electrochromic', v: 17.5 },
    unit: '% of working hours',
    src: 'office tower, sample study',
  },
  {
    cat: 'louvers and shading',
    num: '−71%',
    what: 'sun on the glass behind the louvers',
    a: { l: 'no louvers', v: 389 },
    b: { l: 'louvers', v: 114 },
    unit: 'kWh/m² a year',
    src: 'office building, singapore',
  },
  {
    cat: 'screens and breezeblock',
    num: '−94%',
    what: 'sun on the new glass, with a roof and a block screen',
    a: { l: 'no shade', v: 331 },
    b: { l: 'roof + screen', v: 21 },
    unit: 'kWh/m² a year',
    src: 'bank branch, design stage',
  },
  {
    cat: 'facade systems',
    num: '−91 t',
    what: 'chiller for a 30-floor tower: glass wall to a shaded 40% glass band',
    a: { l: 'glass wall', v: 620 },
    b: { l: 'shaded band', v: 529 },
    unit: 'tons of cooling',
    src: 'office tower, sample study',
  },
  {
    cat: 'roof coatings',
    num: '−9%',
    what: 'a/c electricity, with a white coating on the old roof',
    a: { l: 'before', v: 76.0 },
    b: { l: 'white coating', v: 69.0 },
    unit: 'kWh/m² a year',
    src: 'bank branch, design stage',
  },
];

// ---- the right number: same glass, two metrics (tor_cases.csv G3 / G6) ----
const metrics = [
  { k: 'a/c electricity', unit: 'kWh/m² a year', a: 71.4, b: 66.8, change: '−7%' },
  { k: 'too warm at a desk 1 m from the glass', unit: '% of working hours', a: 29.4, b: 17.5, change: '−40%' },
];

const steps = [
  { icon: 'architecture', name: 'scope', body: 'you send the drawings and the question' },
  { icon: 'view_in_ar', name: 'model', body: 'the building and your product, in grasshopper / honeybee' },
  { icon: 'bolt', name: 'run', body: '8,760 hours of the real climate, or your own definition' },
  { icon: 'description', name: 'report', body: 'results in your template' },
];

const tiers = [
  { n: '01', name: 'project study', body: 'one project, fixed scope, fixed price.' },
  { n: '02', name: 'sales-evidence program', body: 'studies every quarter, a priority queue, your template.' },
  { n: '03', name: 'sales tools', body: 'the workflow as a tool your team runs. entrópica takes the hard cases.', dev: true },
];

const confidentiality = [
  { icon: 'contract', t: 'entrópica signs an nda.' },
  { icon: 'visibility_off', t: 'no client, building or product named, if you prefer.' },
  { icon: 'lock', t: 'your models and data stay private and are never reused.' },
];

const tools = ['rhino / grasshopper', 'ladybug tools', 'energyplus', 'radiance', 'climatestudio'];
---

<BaseLayout
  title="building-performance studies for product manufacturers · entrópica"
  description="independent simulation studies that prove how your product performs in a real building and climate, in days, in your report format."
  locale={locale}
  bare
  bareDark
>
  <!-- 1 · hero -->
  <section class="hero" id="hero">
    <div class="site-wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">// for building-product manufacturers</div>
        <h1>numbers that win the specification.</h1>
        <p class="lede">
          entrópica models the project with your product and delivers a report your
          specifier will accept. in days.
        </p>
        <div class="ctas">
          <a class="btn amber" href="#start">start a study <span class="arrow-tail" aria-hidden="true"></span></a>
          {hasSample ? (
            <a class="btn ghost" href={SAMPLE_REPORT_URL} download>see a sample report</a>
          ) : (
            <a class="btn ghost" href="#products">see the studies</a>
          )}
        </div>
        <ul class="strip" aria-label="in short">
          <li>studies for a global glazing manufacturer</li>
          <li>grasshopper / honeybee</li>
          <li>your report format</li>
          <li>in days</li>
        </ul>
      </div>
      <figure class="tower">
        <svg viewBox={towerBox} role="img" aria-label="the sample-study tower: 30 office floors, each turned 8.18° from the one below. three floors, highlighted, were simulated.">
          {plates.map((p) => (
            <polygon class={p.sim ? 'plate sim' : 'plate'} points={p.points} style={`--d:${p.i * 45}ms`} />
          ))}
        </svg>
        <figcaption>
          <span><b>30</b> floors</span>
          <span><b>8.18°</b> twist a floor</span>
          <span><b>6</b> glass types</span>
          <span class="amb"><b>3</b> floors simulated</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2 · which product do you sell -->
  <section class="band" id="products">
    <div class="site-wrap">
      <div class="eyebrow">// which product do you sell?</div>
      <h2>one study, one number your rep can use.</h2>
      <ul class="tiles">
        {tiles.map((t) => {
          const max = Math.max(t.a.v, t.b.v);
          return (
            <li class="ptile">
              <div class="tile-cat">{t.cat}</div>
              <div class="tile-num">{t.num}</div>
              <div class="tile-what">{t.what}</div>
              <div class="pair" aria-label={`${t.a.l}: ${t.a.v} ${t.unit}. ${t.b.l}: ${t.b.v} ${t.unit}.`}>
                <div class="brow"><span class="bl">{t.a.l}</span><span class="btrack"><i style={`width:${(t.a.v / max) * 100}%`}></i></span><span class="bv">{t.a.v}</span></div>
                <div class="brow b"><span class="bl">{t.b.l}</span><span class="btrack"><i style={`width:${(t.b.v / max) * 100}%`}></i></span><span class="bv">{t.b.v}</span></div>
              </div>
              <div class="tile-foot"><span>{t.unit}</span><span>{t.src}</span></div>
            </li>
          );
        })}
      </ul>
      <p class="fine-note">simulated, independent entrópica studies. glass named by type, never by brand.</p>
    </div>
  </section>

  <!-- 3 · the right number -->
  <section class="band dark">
    <div class="site-wrap">
      <div class="eyebrow">// the right number</div>
      <h2>the same glass, measured two ways.</h2>
      <div class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <div class="m-change">{m.change}</div>
            <div class="m-k">{m.k}</div>
            <div class="m-bars">
              <div class="brow"><span class="bl">double reflective</span><span class="btrack"><i style={`width:${(m.a / m.a) * 100}%`}></i></span><span class="bv">{m.a}</span></div>
              <div class="brow b"><span class="bl">electrochromic</span><span class="btrack"><i style={`width:${(m.b / m.a) * 100}%`}></i></span><span class="bv">{m.b}</span></div>
            </div>
            <div class="m-unit">{m.unit}</div>
          </div>
        ))}
      </div>
      <p class="dark-p">
        energy alone undersells this glass. the desk by the window shows its value.
        finding the number your specifier cares about is part of every study.
      </p>
      <p class="dark-fine">sample study: a 30-floor office tower in a hot-humid climate, energyplus, 8,760 hours.</p>
    </div>
  </section>

  <!-- 4 · what you receive -->
  <section class="band">
    <div class="site-wrap receive">
      <div class="fan" aria-hidden="true">
        <img src="/projects/new-chautauqua-institute/new-chautauqua-institute_05_trade.webp" alt="" width="2160" height="2200" loading="lazy" />
        <img src="/projects/private-bank-offices/private-bank-offices_03_glass.webp" alt="" width="2160" height="2200" loading="lazy" />
        <img src="/projects/l12-ocean-reef/l12-ocean-reef_01_glass.webp" alt="" width="2160" height="2200" loading="lazy" />
      </div>
      <div>
        <div class="eyebrow">// what you receive</div>
        <h2>a report your rep can send the same day.</h2>
        <ul class="get">
          <li><span class="material-symbols-outlined" aria-hidden="true">description</span>the report, in your template</li>
          <li><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span>charts at final size</li>
          <li><span class="material-symbols-outlined" aria-hidden="true">table_chart</span>the results spreadsheet</li>
        </ul>
        <div class="sample">
          {hasSample ? (
            <a class="btn" href={SAMPLE_REPORT_URL} download>download a sample report</a>
          ) : (
            <a class="btn" href={`mailto:${EMAIL}?subject=sample%20report`}>ask for a sample report</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · how it works -->
  <section class="band">
    <div class="site-wrap">
      <div class="eyebrow">// how it works</div>
      <h2>the same four steps on every study.</h2>
      <ol class="flow">
        {steps.map((s, i) => (
          <li>
            <span class="node"><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span></span>
            <span class="step-n">0{i + 1}</span>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="days"><span>in days</span></div>
      <ul class="tools" aria-label="tools">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 6 · offer -->
  <section class="band">
    <div class="site-wrap">
      <div class="eyebrow">// the offer</div>
      <h2>start with one study.</h2>
      <ol class="tiers">
        {tiers.map((t) => (
          <li class={t.dev ? 'tier dev' : 'tier'}>
            <div class="tier-n">{t.n}</div>
            <h3>{t.name}</h3>
            <p>{t.body}</p>
            {t.dev && <div class="tier-tag">in development</div>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7 · confidentiality -->
  <section class="band">
    <div class="site-wrap">
      <div class="eyebrow">// confidentiality</div>
      <ul class="conf">
        {confidentiality.map((c) => (
          <li><span class="material-symbols-outlined" aria-hidden="true">{c.icon}</span>{c.t}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 · close -->
  <section class="band close" id="start">
    <div class="site-wrap">
      <div class="close-grid">
        <div>
          <div class="eyebrow amber">// start a study</div>
          <h2>send the project and the question.</h2>
          <p class="body-p">
            entrópica replies with a fixed price and a turnaround, at no cost.
          </p>
          <ul class="direct">
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            {BOOKING_URL && <li><a href={BOOKING_URL} target="_blank" rel="noopener">book a 20-minute call →</a></li>}
          </ul>
        </div>

        <div class="form-col">
          <div class="sent" id="study-sent" hidden tabindex="-1">
            <div class="eyebrow amber">// received</div>
            <h3>thanks. entrópica replies within one working day.</h3>
          </div>

          <form class="study-form" action={FORMSPREE_ENDPOINT} method="POST" data-ajax data-sent="study-sent" data-lead-type="manufacturer">
            <div class="field">
              <label for="m-name">name</label>
              <input id="m-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="m-company">company</label>
              <input id="m-company" name="company" type="text" required autocomplete="organization" />
            </div>
            <div class="field full">
              <label for="m-email">work email</label>
              <input id="m-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field full">
              <label for="m-project">the project and the question</label>
              <textarea id="m-project" name="project" rows="4" required placeholder="where it is, the product, and what the specifier needs to see"></textarea>
            </div>
            <div class="field full">
              <label for="m-files">link to drawings <span class="opt">(optional)</span></label>
              <input id="m-files" name="files" type="url" placeholder="https://" />
            </div>

            <input type="hidden" name="_subject" value="entropica-lab.com · manufacturer study request" />
            <div class="honeypot" aria-hidden="true">
              <label>do not fill this field</label>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <p class="form-error" data-form-error hidden role="alert">
              the message didn't go through. write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>

            <button type="submit" class="btn amber">send <span class="arrow-tail" aria-hidden="true"></span></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <a class="sticky-cta" href="#start" data-sticky hidden>start a study <span aria-hidden="true">→</span></a>

  <footer class="bare-footer" slot="footer">
    <div class="site-wrap">
      <p>consultancies and architecture teams that need overflow modeling can also get in touch.</p>
      <p class="fine">© {new Date().getFullYear()} entrópica · <a href="/en/privacy">privacy</a></p>
    </div>
  </footer>
</BaseLayout>

<script>
  import '../../scripts/ajax-form';

  // the sticky button shows once the hero is gone, and hides at the form.
  const sticky = document.querySelector<HTMLElement>('[data-sticky]');
  const hero = document.getElementById('hero');
  const start = document.getElementById('start');
  if (sticky && hero && start && 'IntersectionObserver' in window) {
    let heroOn = true;
    let startOn = false;
    const update = () => { sticky.hidden = heroOn || startOn; };
    new IntersectionObserver(([e]) => { heroOn = e.isIntersecting; update(); }).observe(hero);
    new IntersectionObserver(([e]) => { startOn = e.isIntersecting; update(); }, { threshold: 0.15 }).observe(start);
  }
</script>

<style>
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  h2 {
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 48px;
    max-width: 22ch;
    text-wrap: balance;
  }
  h3 { font-size: 17px; letter-spacing: -0.01em; margin: 0 0 8px; }
  .band { padding: 96px 0; border-top: 1px solid var(--line-on-paper); }

  /* ---- hero, on ink ---- */
  .hero { background: var(--ink); color: var(--text); padding: 72px 0 80px; overflow: hidden; }
  .hero .eyebrow { color: var(--mute); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .hero h1 {
    font-size: clamp(40px, 6.6vw, 92px);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 28px;
    max-width: 12ch;
    color: var(--text);
  }
  .lede { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.55; color: var(--mute); max-width: 44ch; margin: 0 0 36px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 48px; }
  .btn.ghost { border-color: var(--line-3); color: var(--text); }
  .btn.ghost:hover { background: var(--text); color: var(--ink); }
  .btn.amber:hover { background: var(--text); border-color: var(--text); color: var(--ink); }
  .strip {
    list-style: none; padding: 18px 0 0; margin: 0; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 6px 0; font-size: 12px; color: var(--mute);
  }
  .strip li:not(:last-child)::after { content: '·'; padding: 0 12px; color: var(--mute-3); }

  .tower { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .tower svg { width: 100%; max-width: 360px; height: auto; max-height: 560px; overflow: visible; }
  .plate {
    fill: var(--ink); stroke: rgba(255, 255, 255, 0.42); stroke-width: 0.22; stroke-linejoin: round;
    animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: var(--d);
  }
  .plate.sim { fill: #3a2f17; stroke: var(--amber); stroke-width: 0.4; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .plate { animation: none; } }
  .tower figcaption {
    margin-top: 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px;
    font-size: 12px; color: var(--mute);
  }
  .tower b { color: var(--text); font-weight: 400; }
  .tower .amb b { color: var(--amber); }

  /* real units keep their case (kWh, W/m²) */
  .tile-foot, .tile-what, .m-unit, .m-k, .dark-fine, .flow p { text-transform: none; }

  /* ---- product tiles ---- */
  .tiles {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--line-on-paper); border: 1px solid var(--line-on-paper);
  }
  .ptile { background: var(--paper); padding: 28px 28px 22px; display: flex; flex-direction: column; transition: background 0.2s; }
  .ptile:hover { background: var(--paper-2); }
  .tile-cat { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper); margin-bottom: 18px; }
  .tile-num {
    font-size: clamp(48px, 5vw, 72px); font-weight: 300; letter-spacing: -0.04em; line-height: 1;
    color: var(--ink-on-paper); text-transform: none; margin-bottom: 12px;
  }
  .tile-what { font-size: 13px; line-height: 1.5; color: var(--mute-on-paper); min-height: 3em; margin-bottom: 22px; }
  .pair, .m-bars { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
  .brow { display: grid; grid-template-columns: 11.5em 1fr 3.4em; align-items: center; gap: 10px; font-size: 11px; color: var(--ink-on-paper); }
  .bl { color: var(--mute-on-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .btrack { height: 10px; background: var(--line-on-paper); }
  .btrack i { display: block; height: 100%; background: #5b564a; }
  .brow.b .btrack i { background: var(--amber); }
  .bv { text-align: right; font-feature-settings: 'tnum' 1; color: var(--ink-on-paper); }
  .metric .bv { color: var(--text); }
  .tile-foot {
    margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line-on-paper);
    display: flex; justify-content: space-between; gap: 12px; font-size: 10.5px; color: var(--mute-on-paper-2);
  }
  .fine-note { margin: 16px 0 0; font-size: 11px; color: var(--mute-on-paper-2); }

  /* ---- the right number, on ink ---- */
  .band.dark { background: var(--ink); color: var(--text); border-top: none; }
  .band.dark .eyebrow { color: var(--mute); }
  .band.dark h2 { color: var(--text); }
  .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-bottom: 36px; }
  .metric { background: var(--ink); padding: 32px; }
  .m-change { font-size: clamp(64px, 8vw, 120px); font-weight: 300; letter-spacing: -0.05em; line-height: 0.95; color: var(--text); margin-bottom: 14px; }
  .metric:last-child .m-change { color: var(--amber); }
  .m-k { font-size: 14px; color: var(--mute); margin-bottom: 26px; min-height: 2.6em; }
  .metric .bl { color: var(--mute); }
  .metric .btrack { background: var(--line); }
  .metric .btrack i { background: rgba(255, 255, 255, 0.55); }
  .metric .brow.b .btrack i { background: var(--amber); }
  .m-unit { font-size: 11px; color: var(--mute-2); }
  .dark-p { font-size: clamp(17px, 1.6vw, 21px); line-height: 1.55; color: var(--text); max-width: 52ch; margin: 0 0 14px; }
  .dark-fine { font-size: 11px; color: var(--mute-2); margin: 0; }

  /* ---- what you receive ---- */
  .receive { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .fan { position: relative; aspect-ratio: 1 / 0.92; }
