---
// /en/projects/ · "work". rev 2 pivot (2026-11-23): simulation studies only.
// a project is a study when its entry has a `study` block (the data panels
// ProjectStudy.astro renders). when lotus hall, l34 or okinawa get their
// reruns, they move here on their own. design-only projects live in the
// architecture archive (/en/architecture/), linked only from about.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const locale = 'en' as const;
const studies = (await getCollection('projects', ({ data }) => data.locale === locale && !data.hidden && !!data.study))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="work · entrópica · building-performance simulation studies"
  description="simulation studies by entrópica: glass, shading, roofs and comfort, each one checked against one fair baseline."
  locale={locale}
>
  <section class="hero">
    <div class="site-wrap">
      <div class="eyebrow">// the work</div>
      <h1 class="hero-h">simulation studies.</h1>
      <p class="hero-lede">
        each one answered a design question with a model, against one fair baseline.
      </p>
    </div>
  </section>

  <section class="projects-section">
    <div class="site-wrap">
      <ProjectGrid projects={studies} />
      <p class="after">need a study like these? <a href="/en/modeling-support/#start">send a project</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 96px 0 64px; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 24px; font-weight: 400; }
  .hero-h { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 28px; font-weight: 300; max-width: 24ch; text-wrap: balance; }
  .hero-lede { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--mute-on-paper); max-width: 60ch; margin: 0; font-weight: 300; }
  .projects-section { padding: 24px 0 96px; }
  .after { margin: 48px 0 0; font-size: 15px; color: var(--mute-on-paper); }
  .after a { color: var(--ink-on-paper); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .after a:hover { color: var(--amber); }
</style>
