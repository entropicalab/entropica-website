---
// /en/contact/ · 2026-11-24: the intake flow (jose's widget, rev 2), the
// same one as on the home page, so every way in asks the same thing.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntakeFlow from '../../components/IntakeFlow.astro';
import { LINKEDIN_COMPANY } from '../../data/business';

const locale = 'en' as const;
---

<BaseLayout
  title="contact · entrópica · building-performance modeling"
  description="send a project or a question. energy, daylight and comfort simulations for consultancies and design teams. info@entropica-lab.com · +507 6200-6909."
  locale={locale}
>
  <section class="contact-hero">
    <div class="site-wrap">
      <div class="eyebrow">// contact</div>
      <h1 class="hero-h">send the project, or just the question.</h1>
      <p class="hero-lede">
        tell us what you need in three taps, then where to send the quote. we
        reply within one business day, monday to friday.
      </p>
    </div>
  </section>

  <section class="contact-body">
    <div class="site-wrap">
      <div class="contact-grid">
        <div class="form-col">
          <IntakeFlow page="contact" />
        </div>

        <aside class="info-col">
          <div class="info-block">
            <div class="eyebrow">// entrópica</div>
            <p>
              ph plaza mar · paitilla<br />
              panamá city · republic of panama<br />
              <span class="muted legal-name">Watts And Matter Consulting, S.EP.</span>
            </p>
          </div>

          <div class="info-block">
            <div class="eyebrow">// direct</div>
            <ul>
              <li><a class="info-link" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a></li>
              <li><a class="info-link" href="https://wa.me/50762006909" target="_blank" rel="noopener">whatsapp · +507 6200-6909</a></li>
              <li><a class="info-link" href={LINKEDIN_COMPANY} target="_blank" rel="noopener">linkedin · entrópica</a></li>
            </ul>
          </div>

          <div class="info-block">
            <div class="eyebrow">// hours</div>
            <p class="muted">
              monday to friday<br />
              09:00 to 17:00 <span class="caps">UTC−5</span>, all year
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-name, .caps { text-transform: none; }
  .contact-hero { padding: 96px 0 56px; }
  .contact-hero .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 400;
  }
  .hero-h {
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    font-weight: 300;
    text-wrap: balance;
  }
  .hero-lede {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--mute-on-paper);
    max-width: 60ch;
    margin: 0;
    font-weight: 300;
  }

  .contact-body { padding: 24px 0 96px; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 80px;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  .form-col { max-width: 640px; }


  .info-col {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 12px;
  }
  .info-block .eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute-on-paper-2);
    font-weight: 400;
    margin-bottom: 10px;
    display: inline-block;
  }
  .info-block p {
    font-size: 14px;
    line-height: 1.65;
    font-weight: 300;
    margin: 0;
  }
  .info-block .muted { color: var(--mute-on-paper); }
  .info-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    font-weight: 300;
  }
  .info-link {
    color: var(--ink-on-paper);
    border-bottom: 1px solid var(--line-on-paper-2);
  }
  .info-link:hover {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }
</style>
