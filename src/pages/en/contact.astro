---
// /en/contact/ · rev 2 pivot (2026-11-23): the same intake as the modeling
// support form, so every form on the site asks the same thing.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tr } from '../../i18n/utils';
import { LINKEDIN } from '../../data/business';

const locale = 'en' as const;
const t = tr(locale);

// formspree form id for info@entropica-lab.com (same endpoint as modeling support).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';
---

<BaseLayout
  title="contact · entrópica · building-performance modeling"
  description="send a project or a question. energy, daylight and comfort simulations for consultancies and design teams. info@entropica-lab.com · +507 6200-6909."
  locale={locale}
>
  <section class="contact-hero">
    <div class="site-wrap">
      <div class="eyebrow">// contact</div>
      <h1 class="hero-h">send the project, or just the question.</h1>
      <p class="hero-lede">
        the drawings you have, what you need to know and the deadline. josé replies
        with a fixed price and a schedule.
      </p>
    </div>
  </section>

  <section class="contact-body">
    <div class="site-wrap">
      <div class="contact-grid">
        <div class="form-col">
          <div class="sent" id="contact-sent" hidden tabindex="-1">
            <div class="eyebrow amber">// message received</div>
            <h2>thanks. josé will reply within one business day.</h2>
            <a class="btn" href="/en/">← home</a>
          </div>

          <form class="contact-form" action={FORMSPREE_ENDPOINT} method="POST" data-ajax data-sent="contact-sent" data-lead-type="modeling-support">
            <div class="field">
              <label for="name">name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>

            <div class="field">
              <label for="company">company</label>
              <input id="company" name="company" type="text" autocomplete="organization" />
            </div>

            <div class="field full">
              <label for="email">work email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>

            <div class="field full">
              <label for="project">project scope and question</label>
              <textarea id="project" name="project" rows="6" required placeholder="building type and location, what you need to know, and your template if you have one"></textarea>
            </div>

            <div class="field">
              <label for="deadline">deadline</label>
              <input id="deadline" name="deadline" type="text" placeholder="e.g. 12 december" />
            </div>

            <div class="field">
              <label for="white_label">white-label?</label>
              <select id="white_label" name="white_label">
                <option value="not sure">not sure</option>
                <option value="yes">yes</option>
                <option value="no">no</option>
              </select>
            </div>

            <div class="field full">
              <label for="files">link to drawings <span class="opt">(optional)</span></label>
              <input id="files" name="files" type="url" placeholder="https://" />
            </div>

            <input type="hidden" name="page" value="contact" />
            <input type="hidden" name="_subject" value="entropica-lab.com · modeling support request (contact page)" />

            <div class="honeypot" aria-hidden="true">
              <label>do not fill this field</label>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <p class="form-error" data-form-error hidden role="alert">
              {t('form.error')} <a class="info-link" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a>.
            </p>

            <div class="actions">
              <button type="submit" class="btn amber">
                send for quote
                <span class="arrow-tail" aria-hidden="true"></span>
              </button>
            </div>
          </form>
        </div>

        <aside class="info-col">
          <div class="info-block">
            <div class="eyebrow">// entrópica</div>
            <p>
              ph plaza mar · paitilla<br />
              panamá city · republic of panama<br />
              <span class="muted legal-name">Watts And Matter Consulting, S.EP.</span>
            </p>
          </div>

          <div class="info-block">
            <div class="eyebrow">// direct</div>
            <ul>
              <li><a class="info-link" href="mailto:info@entropica-lab.com">info@entropica-lab.com</a></li>
              <li><a class="info-link" href="https://wa.me/50762006909" target="_blank" rel="noopener">whatsapp · +507 6200-6909</a></li>
              <li><a class="info-link" href={LINKEDIN} target="_blank" rel="noopener">linkedin · josé barría</a></li>
            </ul>
          </div>

          <div class="info-block">
            <div class="eyebrow">// hours</div>
            <p class="muted">
              monday to friday<br />
              09:00 to 18:00 <span class="caps">UTC−5</span>, all year
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/ajax-form';
</script>

<style>
  .legal-name, .caps { text-transform: none; }
  .opt { color: var(--mute-on-paper-2); }
  .contact-hero { padding: 96px 0 56px; }
  .contact-hero .eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 400;
  }
  .hero-h {
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    font-weight: 300;
    text-wrap: balance;
  }
  .hero-lede {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--mute-on-paper);
    max-width: 60ch;
    margin: 0;
    font-weight: 300;
  }

  .contact-body { padding: 24px 0 96px; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 80px;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  .form-col { max-width: 640px; }

  .sent {
    padding: 32px;
    border: 1px solid var(--line-on-paper);
    background: var(--paper-2);
  }
  .sent .eyebrow {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    font-weight: 400; margin-bottom: 16px; display: inline-block;
  }
  .sent h2 { font-size: 26px; font-weight: 300; letter-spacing: -0.015em; margin: 0 0 12px; }
  .sent p { font-size: 16px; color: var(--mute-on-paper); font-weight: 300; margin: 0 0 24px; line-height: 1.6; }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 12px;
  }
  .info-block .eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute-on-paper-2);
    font-weight: 400;
    margin-bottom: 10px;
    display: inline-block;
  }
  .info-block p {
    font-size: 14px;
    line-height: 1.65;
    font-weight: 300;
    margin: 0;
  }
  .info-block .muted { color: var(--mute-on-paper); }
  .info-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    font-weight: 300;
  }
  .info-link {
    color: var(--ink-on-paper);
    border-bottom: 1px solid var(--line-on-paper-2);
  }
  .info-link:hover {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }
</style>
