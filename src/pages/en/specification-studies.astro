---
// specification studies page (was /en/manufacturers, which now redirects here).
// ON HOLD (rev 3): noindex and out of the sitemap until saint-gobain clears
// publication. at launch: remove `noindex` below and the sitemap filter in
// astro.config.mjs.
// manufacturer landing page. built from "261115 entrópica, manufacturer
// landing page · build spec" and reworked per "261115 website rework, design
// direction + fixes". english only, no spanish mirror, no site nav: the
// outbound email links here and the page has one job.
//
// the one rule: evidence and clarity unlimited, claims and urgency never.
// every number names what it is compared with. every figure comes from a
// published study or the tornillo sample study export
// (C:\Entropica\047-ElTornillo\sim_export\tor_cases.csv). check it there
// before changing it. glass is named by type only. the tower is never named.
// bar colors follow the data color system (brand guidelines 03b):
// calor ramp for cooling and heat, sol ramp for sun.
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGlobe from '../../components/WorkGlobe.astro';

const locale = 'en' as const;

// formspree form id for info@entropica-lab.com (same endpoint as /contact).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';
const EMAIL = 'info@entropica-lab.com';

// fill when the anonymized sample report exists. while empty, the page
// offers it by email.
const SAMPLE_REPORT_URL = ''; // e.g. '/manufacturers/sample-report.pdf'
const hasSample = SAMPLE_REPORT_URL !== '';

// ---- hero: the sample-study tower, drawn from its real geometry ----------
// 30 typical floors, plate 26.94 m square, 4.04 m floor to floor, 8.18° twist
// per floor, counterclockwise going up. floors 10, 14 and 17 were simulated.
const FLOORS = 30;
const HALF = 26.94 / 2;
const STEP = 4.04;
const TWIST = (8.18 * Math.PI) / 180;
const SIMULATED = [10, 14, 17];
const C30 = Math.cos(Math.PI / 6);
const S30 = Math.sin(Math.PI / 6);
// each floor is drawn as a solid: the two side faces that face the viewer,
// then the roof plate. drawn bottom to top, so upper floors cover lower ones.
const fmt = (pts: number[][]) => pts.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');
const plates = Array.from({ length: FLOORS }, (_, i) => {
  const a = i * TWIST;
  const z0 = i * STEP;
  const z1 = z0 + STEP;
  const corners = [
    [-HALF, -HALF],
    [HALF, -HALF],
    [HALF, HALF],
    [-HALF, HALF],
  ].map(([x, y]) => [x * Math.cos(a) - y * Math.sin(a), x * Math.sin(a) + y * Math.cos(a)]);
  const proj = (rx: number, ry: number, z: number) => [(rx - ry) * C30, (rx + ry) * S30 - z];
  // depth: larger rx + ry sits nearer the viewer. keep the two nearest faces.
  const faces = corners
    .map((c, k) => {
      const d = corners[(k + 1) % 4];
      return { depth: c[0] + c[1] + d[0] + d[1], pts: [proj(c[0], c[1], z0), proj(d[0], d[1], z0), proj(d[0], d[1], z1), proj(c[0], c[1], z1)] };
    })
    .sort((p, q) => p.depth - q.depth)
    .slice(2)
    .map((f, k) => ({ points: fmt(f.pts), shade: k }));
  return {
    i,
    sim: SIMULATED.includes(i + 1),
    faces,
    roof: fmt(corners.map(([rx, ry]) => proj(rx, ry, z1))),
  };
});
const W = HALF * 1.5;
const towerTop = -(FLOORS - 1) * STEP - HALF * 1.45;
const towerBox = `${(-W).toFixed(1)} ${towerTop.toFixed(1)} ${(W * 2).toFixed(1)} ${(-towerTop + HALF * 1.6).toFixed(1)}`;
const groundY = (HALF * 1.5).toFixed(1);

// ---- results, one per product type ---------------------------------------
// say = the sentence a rep can use. num + numUnit = the headline figure, unit
// in words. a = compared with, b = with the product. u = the unit on each bar.
// ramp: 'calor' (cooling, heat) or 'sol' (sun). refrigeration tons to kW at
// 3.517 kW per ton.
const results = [
  {
    cat: 'glazing',
    say: 'the right glass cuts the chiller a 30-floor tower needs by 232 refrigeration tons.',
    num: '−232',
    numUnit: 'refrigeration tons of chiller capacity (816 kW)',
    a: { l: 'single clear', v: 852 },
    b: { l: 'double reflective', v: 620 },
    u: ' tons',
    unit: 'chiller capacity, refrigeration tons',
    src: 'office tower, sample study',
    ramp: 'calor',
  },
  {
    cat: 'facade systems',
    say: 'a shaded glass band cuts the same tower’s chiller by another 91 refrigeration tons.',
    num: '−91',
    numUnit: 'refrigeration tons of chiller capacity (320 kW)',
    a: { l: 'glass wall', v: 620 },
    b: { l: 'shaded band', v: 529 },
    u: ' tons',
    unit: 'chiller capacity, refrigeration tons',
    src: 'office tower, sample study',
    ramp: 'calor',
  },
  {
    cat: 'dynamic glass',
    say: 'the desk by the window is too warm in under 2 of 10 working hours, down from 3.',
    num: '−40%',
    numUnit: 'too-warm working hours at a desk 1 m from the glass',
    a: { l: 'double reflective', v: 29.4 },
    b: { l: 'electrochromic', v: 17.5 },
    u: '%',
    unit: 'share of working hours too warm',
    src: 'office tower, sample study',
    ramp: 'calor',
    note: 'comfort',
  },
  {
    cat: 'louvers and shading',
    say: 'louvers cut the solar radiation reaching the glass by 71%.',
    num: '−71%',
    numUnit: 'solar radiation on the glass, per year',
    a: { l: 'no louvers', v: 389 },
    b: { l: 'louvers', v: 114 },
    u: ' kWh/m²',
    unit: 'solar radiation on the glass, kWh/m² a year',
    src: 'academic study, singapore',
    ramp: 'sol',
  },
  {
    cat: 'screens and breezeblock',
    say: 'a roof and a block screen cut the solar radiation on the new glass by 94%.',
    num: '−94%',
    numUnit: 'solar radiation on the glass, per year',
    a: { l: 'no shade', v: 331 },
    b: { l: 'roof + screen', v: 21 },
    u: ' kWh/m²',
    unit: 'solar radiation on the glass, kWh/m² a year',
    src: 'bank branch, design stage',
    ramp: 'sol',
  },
];

// ---- judgment: same glass, two metrics (tor_cases.csv G3 / G6) ----------
const metrics = [
  { k: 'a/c electricity', unit: 'kWh/m² of floor a year', u: ' kWh/m²', a: 71.4, b: 66.8, change: '−6.5%' },
  { k: 'too warm at a desk 1 m from the glass', unit: 'share of working hours', u: '%', a: 29.4, b: 17.5, change: '−40%' },
];

// the client sends only what they already have. no model, no template.
const youSend = [
  { icon: 'architecture', t: 'a drawing or a sketch of the project' },
  { icon: 'description', t: 'the product: its name or its datasheet' },
  { icon: 'help', t: 'what your client needs to know' },
];

const weDo = [
  { icon: 'view_in_ar', t: 'model the building with your product in it' },
  { icon: 'bolt', t: 'run all requested simulations, 8,760 hours of the local climate' },
  { icon: 'fact_check', t: 'review every result' },
  { icon: 'send', t: 'send a report ready to forward, typically in 5 business days' },
];

// the study datasheet (rev 3, 6b). replaces the offer, the icon list and the
// confidentiality block.
const datasheet = [
  { k: 'you send', v: 'a drawing or sketch, the product (name or datasheet), the question' },
  { k: 'you receive', v: 'a report ready to forward, charts at final size, the results spreadsheet, the result in one plain sentence' },
  { k: 'turnaround', v: 'typically 5 business days' },
  { k: 'price', v: 'from USD 2,500, fixed, and quoted free within one working day' },
  { k: 'confidentiality', v: 'NDA on request · no client, building or product named, if you prefer · models and data never reused' },
  { k: 'reviewed by', v: 'josé barría, lead modeler' },
];

const COMFORT = 'too warm: pmv above +0.5 (ashrae 55 pmv model; 1.1 met, 0.5 clo, air at 0.1 m/s). with the a/c at 24 °C and 53% humidity: operative temperature above 27 °C.';
const SCALING = '3 typical floors simulated. every floor has the same plate, rotated 8.18°, so results are scaled to 30 floors.';

const tools = ['rhino / grasshopper', 'ladybug tools', 'energyplus', 'radiance', 'climatestudio'];
---

<BaseLayout
  title="specification studies for building-product manufacturers · entrópica"
  description="simulation studies that show how your product performs in a real building and climate. modeled and reviewed by people, in days."
  locale={locale}
  bare
  noindex
  ogImage="/og-specification-studies.jpg"
>
  <!-- 1 · hero: what it is, for whom, and a real result -->
  <section class="hero" id="hero">
    <div class="site-wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">energy engineering for your sales team</p>
        <h1>numbers that win the specification.</h1>
        <p class="lede">
          we model the real project with your product in it, so your rep can show the
          client what it does in their building. typically in 5 business days.
        </p>
        <div class="ctas">
          <a class="btn amber" href="#start">start a study <span class="arrow-tail" aria-hidden="true"></span></a>
          <a class="btn ghost" href="#results">see what a study shows</a>
        </div>
        <p class="proof">
          entrópica has run performance studies for a global glazing manufacturer. our
          lead modeler has modeled buildings in nine places on five continents.
        </p>
        <ul class="strip" aria-label="in short">
          <li>every result reviewed by an expert</li>
          <li>evidence that holds up in value engineering</li>
          <li>in your timezone</li>
          <li class="caps">NDA on request</li>
        </ul>
      </div>

      <figure class="sheet" aria-label="a result from the sample study">
        <div class="sheet-head">
          <span>sample study</span>
          <span>hot-humid climate</span>
        </div>
        <div class="sheet-body">
          <svg class="tower" viewBox={towerBox} role="img" aria-label="a 30-floor office tower, each floor turned 8.18° from the one below. the three simulated floors are highlighted.">
            <line class="ground" x1={(-W).toFixed(1)} x2={W.toFixed(1)} y1={groundY} y2={groundY} />
            {plates.map((p) => (
              <g class={p.sim ? 'floor sim' : 'floor'} style={`--d:${p.i * 40}ms`}>
                {p.faces.map((f) => <polygon class={`face f${f.shade}`} points={f.points} />)}
                <polygon class="roof" points={p.roof} />
              </g>
            ))}
          </svg>
          <div class="sheet-result">
            <div class="sheet-label">30-floor office tower</div>
            <div class="sheet-num">−232</div>
            <p class="sheet-numunit">refrigeration tons of chiller (816 kW), with the right glass</p>
            <div class="pair">
              <div class="brow calor"><span class="bl">single clear</span><span class="btrack"><i style="width:100%"></i></span><span class="bv">852 tons</span></div>
              <div class="brow calor b"><span class="bl">double reflective</span><span class="btrack"><i style={`width:${(620 / 852) * 100}%`}></i></span><span class="bv">620 tons</span></div>
            </div>
            <div class="sheet-unit">chiller capacity, refrigeration tons</div>
          </div>
        </div>
        <figcaption class="sheet-foot">
          <span>energyplus · 8,760 hours</span>
          <span><span class="dot" aria-hidden="true"></span>3 floors simulated, scaled to 30</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 1b · the core message: a firm of people, no added work -->
  <section class="core">
    <div class="site-wrap">
      <p class="core-p">
        entrópica is not software your team has to learn and run. a person does the
        energy engineering for you. you send a drawing and the product. we do
        everything else.
      </p>
    </div>
  </section>

  <!-- 2 · what, why it helps, why us -->
  <section class="band">
    <div class="site-wrap">
      <ol class="three">
        <li>
          <span class="three-n">what it is</span>
          <h2 class="h3">a study of one real project, with your product in it.</h2>
          <p>the building, its climate, your product’s performance, and the one number the client needs to see.</p>
        </li>
        <li>
          <span class="three-n">why it helps you</span>
          <h2 class="h3">datasheets don’t win specifications. project numbers do.</h2>
          <p>your rep walks in with what the product does in this building, in this climate. and when value engineering comes, the study is what keeps your product in the specification.</p>
        </li>
        <li>
          <span class="three-n">why us</span>
          <h2 class="h3">we have modeled buildings since 2020.</h2>
          <p>we know which baseline is fair, which weather file is right, and which number your client will ask about. we read every result before you see it, and we tell you plainly what it means.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 3 · you send almost nothing -->
  <section class="band tint">
    <div class="site-wrap">
      <p class="kicker">how it works</p>
      <h2>you send what you already have. we do the rest.</h2>
      <div class="handoff">
        <div class="side">
          <div class="side-h">you send</div>
          <ul class="steps">
            {youSend.map((s) => (
              <li><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.t}</li>
            ))}
          </ul>
          <p class="no-problem">no energyplus model? no problem. no template, no data to collect. we build it all.</p>
        </div>
        <div class="arrow-mid" aria-hidden="true"><span class="material-symbols-outlined">arrow_forward</span></div>
        <div class="side we">
          <div class="side-h">we do</div>
          <ol class="steps">
            {weDo.map((s) => (
              <li><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.t}</li>
            ))}
          </ol>
          <p class="days">typically 5 business days</p>
        </div>
      </div>
      <div class="tz">
        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
        <p>
          we work from panamá, on <span class="caps">UTC−5</span> all year. that is the same working day as the
          <span class="caps">US</span>, canada and latin america, so questions get answered today, not overnight.
        </p>
      </div>
      <ul class="tools" aria-label="tools">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 4 · why a person -->
  <section class="band dark">
    <div class="site-wrap">
      <p class="kicker">why a person checks every number</p>
      <h2>in a high-value proposal, an unchecked claim is a liability.</h2>
      <div class="why-grid">
        <p class="why-p">
          software and <span class="caps">AI</span> tools now produce energy numbers in seconds. an unchecked
          model can be wrong in ways that look right: the wrong baseline, the wrong
          weather file, a metric that hides what the product does. an inaccurate claim
          can sink the specification.
        </p>
        <p class="why-p">
          every study we send is modeled, reviewed and explained by a person. part of
          that work is finding the number your client cares about. here is one glass,
          measured two ways.
        </p>
      </div>
      <div class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <div class="m-change">{m.change}</div>
            <div class="m-k">{m.k}</div>
            <div class="pair">
              <div class="brow calor"><span class="bl">double reflective</span><span class="btrack"><i style="width:100%"></i></span><span class="bv">{m.a}{m.u}</span></div>
              <div class="brow calor b"><span class="bl">electrochromic</span><span class="btrack"><i style={`width:${(m.b / m.a) * 100}%`}></i></span><span class="bv">{m.b}{m.u}</span></div>
            </div>
            <div class="m-unit">{m.unit}</div>
          </div>
        ))}
      </div>
      <p class="dark-p">energy alone would undersell this glass. the desk by the window shows its value.</p>
      <p class="dark-fine">sample study: a 30-floor office tower in a hot-humid climate, energyplus, 8,760 hours. {SCALING}</p>
      <p class="dark-fine">{COMFORT}</p>
    </div>
  </section>

  <!-- 4b · who does the work, and where -->
  <section class="band">
    <div class="site-wrap">
      <p class="kicker">who does the work</p>
      <h2>you talk to the person who checks your numbers.</h2>
      <div class="who">
        <div class="who-left">
          <div class="who-head">
            <img class="who-img" src="/jose.jpg" alt="josé barría" width="1500" height="1500" loading="lazy" />
            <div class="who-name">
              <b>josé barría</b>
              <span>founder · lead modeler</span>
            </div>
          </div>
          <blockquote class="who-note">
            <p>
              i trained as an architect and studied environmental building design at the
              university of pennsylvania. i have modeled buildings in nine places on five
              continents.
            </p>
            <p>
              a model always gives a number. most of my work is deciding which number is
              fair: the baseline, the weather file, the metric. on the tower on this page,
              the energy result said the electrochromic glass saved 6.5% of the a/c
              electricity. the desk by the window said it cut the too-warm hours by 40%.
              the second number is the one a client remembers, and it is the one i would
              put in front of them.
            </p>
            <p>
              i read every study before it leaves. if a number does not hold up, it does
              not go out.
            </p>
            <footer class="who-sign">josé barría, founder · lead modeler</footer>
          </blockquote>
          <ul class="who-facts">
            <li><b class="caps">M.EBD</b><span>university of pennsylvania, 2017</span></li>
            <li><b>2020</b><span>modeling building performance since</span></li>
            <li><b>9</b><span>places on 5 continents</span></li>
          </ul>
        </div>
        <div class="who-right">
          <WorkGlobe />
        </div>
      </div>
    </div>
  </section>

<!-- 5 · results by product -->
  <section class="band tint" id="results">
    <div class="site-wrap">
      <p class="kicker">results from past studies</p>
      <h2>one study, one sentence your rep can use.</h2>
      <ul class="results">
        {results.map((r) => {
          const max = Math.max(r.a.v, r.b.v);
          return (
            <li class="result">
              <div class="r-cat">{r.cat}</div>
              <p class="r-say">{r.say}</p>
              <div class="r-num">{r.num}</div>
              <p class="r-numunit">{r.numUnit}</p>
              <div class="pair" aria-label={`${r.a.l}: ${r.a.v}${r.u}. ${r.b.l}: ${r.b.v}${r.u}. ${r.unit}.`}>
                <div class={`brow ${r.ramp}`}><span class="bl">{r.a.l}</span><span class="btrack"><i style={`width:${(r.a.v / max) * 100}%`}></i></span><span class="bv">{r.a.v}{r.u}</span></div>
                <div class={`brow ${r.ramp} b`}><span class="bl">{r.b.l}</span><span class="btrack"><i style={`width:${(r.b.v / max) * 100}%`}></i></span><span class="bv">{r.b.v}{r.u}</span></div>
              </div>
              <div class="r-foot"><span>{r.unit}</span><span>{r.src}</span></div>
              {r.note === 'comfort' && <p class="r-note">{COMFORT}</p>}
            </li>
          );
        })}
        <li class="result ask">
          <div class="r-cat">your product</div>
          <p class="r-say">roofing, coatings, insulation, or something else? send the datasheet and the project.</p>
          <a class="btn amber" href="#start">start a study <span class="arrow-tail" aria-hidden="true"></span></a>
        </li>
      </ul>
      <p class="fine-note">simulated, independent entrópica studies. each number is shown with what it was compared with. glass named by type, never by brand. office tower: {SCALING}</p>
      <div class="ve">
        <div class="ve-k">value engineering</div>
        <p>
          value engineering is when a contractor proposes a cheaper product in place of
          yours. the study is your rep's answer: what your product does in this
          building, in numbers the client already agreed to.
        </p>
      </div>
    </div>
  </section>

  <!-- 6 · what you receive: the deliverable, then the study datasheet -->
  <section class="band">
    <div class="site-wrap">
      <p class="kicker">what you receive</p>
      <h2>a report your rep can forward the same day.</h2>
      <div class="pages">
        <figure class="pg pg-cover">
          <div class="cv-top">
            <span>entrópica</span>
            <span>performance study</span>
          </div>
          <div class="cv-title">a 30-floor office tower, six glass types and a designed facade</div>
          <div class="cv-meta">
            <span>hot-humid climate</span>
            <span>energyplus · 8,760 hours</span>
            <span>reviewed by josé barría</span>
          </div>
          <figcaption>the cover</figcaption>
        </figure>
        <figure class="pg">
          <img src="/studies/office-tower/desk.webp" alt="a report page from the office tower study: working hours too warm at a desk, by distance from the facade, for four glass and facade options" width="1080" height="1100" loading="lazy" />
          <figcaption>a chart at final size</figcaption>
        </figure>
        <figure class="pg">
          <img src="/studies/office-tower/chiller.webp" alt="a report page from the office tower study: cooling load for every hour of the year and the chiller size for four glass and facade options" width="1080" height="1100" loading="lazy" />
          <figcaption>the numbers behind it</figcaption>
        </figure>
        <figure class="pg sentence">
          <div class="st-k">the result, in one sentence</div>
          <p>“a designed facade with 40% glass needs a chiller 91 refrigeration tons smaller than the glass tower as built.”</p>
          <figcaption>for your rep to say</figcaption>
        </figure>
      </div>
      <p class="fine-note">pages from the office tower sample study. the anonymized sample report is in preparation: {hasSample ? <a href={SAMPLE_REPORT_URL} download>download it</a> : <a href={`mailto:${EMAIL}?subject=sample%20report`}>ask for it by email</a>}.</p>

      <table class="datasheet">
        <caption>project study · datasheet</caption>
        <tbody>
          {datasheet.map((r) => (
            <tr><th scope="row">{r.k}</th><td class="ds-v">{r.v}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="program">need studies every quarter? the sales-evidence program is quoted on scope.</p>
    </div>
  </section>

<!-- 9 · close -->
  <section class="band close" id="start">
    <div class="site-wrap">
      <div class="close-grid">
        <div>
          <p class="kicker">start a study</p>
          <h2>send the project and the question.</h2>
          <ol class="next">
            <li><span>01</span><span>you send the project and the question.</span></li>
            <li><span>02</span><span>within one working day, josé replies with a fixed price and a turnaround. <span class="caps-in">NDA</span> first, if you need one.</span></li>
            <li><span>03</span><span>the report arrives, typically in 5 business days.</span></li>
          </ol>
          <div class="replier">
            <img src="/jose.jpg" alt="josé barría" width="1500" height="1500" loading="lazy" />
            <p>you hear back from josé.<br /><span>finding out costs nothing.</span></p>
          </div>
          <ul class="direct">
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          </ul>
        </div>

        <div class="form-col">
          <div class="sent" id="study-sent" hidden tabindex="-1">
            <p class="kicker">received</p>
            <h3>thanks. josé replies within one working day.</h3>
          </div>

          <form class="study-form" action={FORMSPREE_ENDPOINT} method="POST" data-ajax data-sent="study-sent" data-lead-type="manufacturer">
            <div class="field">
              <label for="m-name">name</label>
              <input id="m-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="m-company">company</label>
              <input id="m-company" name="company" type="text" required autocomplete="organization" />
            </div>
