---
// specification studies page (was /en/manufacturers, which now redirects here).
// ON HOLD (rev 3): noindex and out of the sitemap until saint-gobain clears
// publication. at launch: remove `noindex` below and the sitemap filter in
// astro.config.mjs.
// manufacturer landing page. built from "261115 entrópica, manufacturer
// landing page · build spec" and reworked per "261115 website rework, design
// direction + fixes". english only, no spanish mirror, no site nav: the
// outbound email links here and the page has one job.
//
// the one rule: evidence and clarity unlimited, claims and urgency never.
// every number names what it is compared with. every figure comes from a
// published study or the tornillo sample study export
// (C:\Entropica\047-ElTornillo\sim_export\tor_cases.csv). check it there
// before changing it. glass is named by type only. the tower is never named.
// bar colors follow the data color system (brand guidelines 03b):
// calor ramp for cooling and heat, sol ramp for sun.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCutaway from '../../components/ProductCutaway.astro';
import ClientBand from '../../components/ClientBand.astro';
import TowerSheet from '../../components/TowerSheet.astro';
import ResultCards from '../../components/ResultCards.astro';
import StudyDatasheet from '../../components/StudyDatasheet.astro';
import WhoDoesTheWork from '../../components/WhoDoesTheWork.astro';
import StudyFooter from '../../components/StudyFooter.astro';
import { COMFORT, SCALING } from '../../data/studies';
import '../../styles/study-page.css';

const locale = 'en' as const;

// formspree form id for info@entropica-lab.com (same endpoint as /contact).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';
const EMAIL = 'info@entropica-lab.com';

// fill when the anonymized sample report exists. while empty, the page
// offers it by email.
// the line under the report pages offers the full sample report by email.
// it must exist before launch (jose, 2026-11-17: page is under construction).
const SAMPLE_REPORT_URL = ''; // e.g. '/manufacturers/sample-report.pdf'
const hasSample = SAMPLE_REPORT_URL !== '';


// ---- judgment: same glass, two metrics (tor_cases.csv G3 / G6) ----------
const metrics = [
  { k: 'cooling electricity', unit: 'kWh/m² of floor a year', u: ' kWh/m²', a: 71.4, b: 66.8, change: '−6.5%' },
  { k: 'overheated working hours, 1 m from the glass', unit: 'share of working hours', u: '%', a: 29.4, b: 17.5, change: '−40%' },
];

// the client sends only what they already have. no model, no template.
const youSend = [
  { icon: 'architecture', t: 'a plan set, an elevation, or an early massing sketch' },
  { icon: 'description', t: 'your product cut sheet or performance specs' },
  { icon: 'help', t: 'the baseline you’re competing against, or the metric the client cares about' },
];

const weDo = [
  { icon: 'view_in_ar', t: 'rebuild the building geometry and the local climate' },
  { icon: 'bolt', t: 'run full-year, 8,760-hour simulations of your product against the baseline' },
  { icon: 'fact_check', t: 'sanity-check every output against the physics' },
  { icon: 'send', t: 'package the findings in a clear report, with a one-sentence sales takeaway' },
];

// the study datasheet. replaces the offer, the icon list and the
// confidentiality block.
const datasheet = [
  { k: 'you send', v: 'project drawings or a massing sketch · product cut sheet · the baseline or metric to beat' },
  { k: 'you receive', v: 'client-ready PDF report · slide-ready, high-resolution charts · full results spreadsheet · one-sentence sales takeaway' },
  { k: 'turnaround', v: '5 business days, standard' },
  { k: 'price', v: 'from USD 2,500 · fixed-fee quote within 1 business day' },
  { k: 'confidentiality', v: 'NDA on request · anonymized, unbranded reporting if you prefer · geometry and data never reused' },
  { k: 'reviewed by', v: 'josé barría, founder and lead modeler' },
];

const tools = ['rhino / grasshopper', 'ladybug tools', 'energyplus', 'radiance', 'climatestudio'];
---

<BaseLayout
  title="specification studies for building-product manufacturers · entrópica"
  description="building-performance studies for product manufacturers. we model your client’s actual building in its local climate and deliver project-specific performance data, checked by a human modeler."
  locale={locale}
  bare
  noindex
  ogImage="/og-specification-studies.jpg"
>
  <!-- 1 · hero: what it is, for whom, and a real result -->
  <section class="hero" id="hero">
    <div class="site-wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">building-performance studies for product manufacturers</p>
        <h1>numbers that win the specification.</h1>
        <p class="lede">
          we model your client’s actual building in its local climate, so your sales
          team gets hard, project-specific performance data. typically in five
          business days.
        </p>
        <div class="ctas">
          <a class="btn amber" href="#start">start a study <span class="arrow-tail" aria-hidden="true"></span></a>
          <a class="btn ghost" href="#results">see sample results</a>
        </div>
        <p class="proof">
          trusted by a global glazing manufacturer. led by an architect licensed in panamá, who has
          modeled buildings in nine cities on five continents.
        </p>
        <ul class="strip" aria-label="in short">
          <li>built and checked by a human modeler</li>
          <li>numbers that hold up in value engineering</li>
          <li>live collaboration in americas time zones</li>
          <li><span><span class="caps">NDA</span> on request · models never reused</span></li>
        </ul>
      </div>

      <TowerSheet />
    </div>
  </section>

  <!-- 1a · clients: firms we've run building simulations for -->
  <section class="clients-band" aria-label="clients">
    <div class="site-wrap"><ClientBand /></div>
  </section>

  <!-- 1b · the core message: done for you, by a person -->
  <section class="core">
    <div class="site-wrap">
      <p class="core-p">
        software still leaves your team doing the modeling. entrópica is a
        <b>done-for-you simulation service</b>: you hand off the project drawings and
        product data, and an experienced modeler builds, runs and interprets the
        simulation for you.
      </p>
    </div>
  </section>

  <!-- 2 · what, why it helps, why us -->
  <section class="band">
    <div class="site-wrap">
      <ol class="three">
        <li>
          <span class="three-n">what it is</span>
          <h2 class="h3">a dedicated performance study for a live project.</h2>
          <p>we model the actual building geometry, the local climate and your product’s exact thermal or optical properties, then isolate the metric that matters most to the decision-maker.</p>
        </li>
        <li>
          <span class="three-n">why it helps you</span>
          <h2 class="h3">datasheets don’t win specifications. project numbers do.</h2>
          <p>generic catalog specs are easy to substitute. project-specific physics are not. your rep gets hard evidence tailored to the building, so architects and engineers have the numbers to push back on cheaper "or-equal" swaps in value engineering.</p>
        </li>
        <li>
          <span class="three-n">why us</span>
          <h2 class="h3">experienced judgment on every model.</h2>
          <p>a simulation is only as credible as its assumptions. we build a fair baseline, isolate your product’s real effect, and stress-test the numbers before a skeptical engineer sees them. every study is reviewed personally and written in plain language, not academic jargon. if your own simulation team is busy with live bids, we take the overflow.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 2b · one study, up close: the bank branch cutaway -->
  <section class="band cutaway">
    <div class="site-wrap">
      <p class="kicker">one study, up close</p>
      <h2>one building. four products. four answers.</h2>
      <p class="lede">four products on one building. for each: the question a buyer asks, the number, and when it holds.</p>
      <ProductCutaway />
    </div>
  </section>

  <!-- 3 · the process -->
  <section class="band tint">
    <div class="site-wrap">
      <p class="kicker">the process</p>
      <h2>you bring the project files. we build the proof.</h2>
      <div class="handoff">
        <div class="side">
          <div class="side-h">you send</div>
          <ul class="steps">
            {youSend.map((s) => (
              <li><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.t}</li>
            ))}
          </ul>
          <p class="no-problem">you don’t need an energyplus file, a <span class="caps">BIM</span> model or a long questionnaire. send whatever is already in your inbox.</p>
        </div>
        <div class="arrow-mid" aria-hidden="true"><span class="material-symbols-outlined">arrow_forward</span></div>
        <div class="side we">
          <div class="side-h">we do</div>
          <ol class="steps">
            {weDo.map((s) => (
              <li><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.t}</li>
            ))}
          </ol>
          <p class="days">typically delivered in 5 business days</p>
        </div>
      </div>
      <div class="tz">
        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
        <p>
          we work from panamá, on <span class="caps">UTC−5</span> all year, inside north and south
          american business hours. when a bid deadline is tight, you get answers the
          same day.
        </p>
      </div>
      <ul class="tools" aria-label="tools">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 4 · why human judgment matters -->
  <section class="band dark">
    <div class="site-wrap">
      <p class="kicker">why human judgment matters</p>
      <h2>in a high-value proposal, an unchecked claim is a liability.</h2>
      <div class="why-grid">
        <p class="why-p">
          automated tools and <span class="caps">AI</span> wrappers produce energy numbers in seconds.
          the real risk is a model that looks plausible on paper and falls apart under
          scrutiny: an unfair baseline, sloppy zoning assumptions, or a metric that
          misses the point. if an <span class="caps">MEP</span> engineer finds a hole in your numbers,
          you can lose the spec.
        </p>
        <p class="why-p">
          every entrópica study is built, checked and interpreted by an experienced
          modeler. half the job is finding the metric that actually proves your
          product’s value. here is one glazing comparison from our sample tower, the
          same glass measured two ways:
        </p>
      </div>
      <div class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <div class="m-change">{m.change}</div>
            <div class="m-k">{m.k}</div>
            <div class="pair">
              <div class="brow calor"><span class="bl">double reflective</span><span class="btrack"><i style="width:100%"></i></span><span class="bv">{m.a}{m.u}</span></div>
              <div class="brow calor b"><span class="bl">electrochromic</span><span class="btrack"><i style={`width:${(m.b / m.a) * 100}%`}></i></span><span class="bv">{m.b}{m.u}</span></div>
            </div>
            <div class="m-unit">{m.unit}</div>
          </div>
        ))}
      </div>
      <p class="dark-p">
        whole-building energy alone would undersell this glass. comfort at the
        perimeter tells the real story, and gives your rep a concrete reason to
        justify the upgrade.
      </p>
      <p class="dark-fine">sample study: a 30-floor office tower in a hot-humid climate, energyplus, 8,760 hours. {SCALING}</p>
      <p class="dark-fine">{COMFORT}</p>
    </div>
  </section>

  <!-- 4b · who does the work, and where -->
  <section class="band">
    <div class="site-wrap">
      <p class="kicker">who does the work</p>
      <h2>you talk directly to the person behind the numbers.</h2>
      <WhoDoesTheWork />
    </div>
  </section>

  <!-- 5 · results by product -->
  <section class="band tint" id="results">
    <div class="site-wrap">
      <p class="kicker">results from past studies</p>
      <h2>hard numbers your rep can put straight into the pitch.</h2>
      <ResultCards>
        <li class="result ask">
          <div class="r-cat">your product</div>
          <p class="r-say">working with another envelope system? send the datasheet and the project drawings to scope a study.</p>
          <a class="btn amber" href="#start">start a study <span class="arrow-tail" aria-hidden="true"></span></a>
        </li>
      </ResultCards>
      <p class="fine-note">independent performance studies, simulated by entrópica against clear baselines. glass is named by generic type, never by brand. office tower: {SCALING}</p>
      <div class="ve">
        <div class="ve-k">built for value engineering</div>
        <p>
          every manufacturer knows the drill: you win the architectural spec, then a
          contractor tries to value-engineer you out before procurement. the report
          gives your rep the evidence to hold the line: your product’s value, in the
          building metrics the owner and engineer already work with.
        </p>
      </div>
    </div>
  </section>

  <!-- 6 · deliverables: the report pages, then the study datasheet -->
  <section class="band">
    <div class="site-wrap">
      <p class="kicker">deliverables</p>
      <h2>a client-ready report your rep can forward the same day.</h2>
      <div class="pages">
        <figure class="pg pg-cover">
          <div class="cv-top">
            <span>entrópica</span>
            <span>performance study</span>
          </div>
          <div class="cv-title">a 30-floor office tower, six glass types and a designed facade</div>
          <div class="cv-meta">
            <span>hot-humid climate</span>
            <span>energyplus · 8,760 hours</span>
            <span>reviewed by josé barría</span>
          </div>
          <figcaption>the cover</figcaption>
        </figure>
        <figure class="pg">
          <img src="/studies/office-tower/desk.webp" alt="a report page from the office tower study: overheated working hours at a desk, by distance from the facade, for four glass and facade options" width="1080" height="1100" loading="lazy" />
          <figcaption>slide-ready charts</figcaption>
        </figure>
        <figure class="pg">
          <img src="/studies/office-tower/chiller.webp" alt="a report page from the office tower study: cooling load for every hour of the year and the chiller size for four glass and facade options" width="1080" height="1100" loading="lazy" />
          <figcaption>hourly load and sizing data</figcaption>
        </figure>
        <figure class="pg sentence">
          <div class="st-k">the executive summary, in one line</div>
          <p>“a designed facade with 40% glass needs a chiller 91 refrigeration tons smaller than the glass tower as built.”</p>
          <figcaption>the pitch takeaway</figcaption>
        </figure>
      </div>
      <p class="fine-note">excerpts from our 30-floor office tower study. {hasSample ? <a href={SAMPLE_REPORT_URL} download>download the full anonymized sample report</a> : <a href={`mailto:${EMAIL}?subject=sample%20report`}>email us for the full anonymized sample report</a>}.</p>

      <StudyDatasheet caption="project study · datasheet" rows={datasheet} />
      <p class="program">supporting several active bids each quarter? ask about a quarterly retainer scoped to your pipeline.</p>
    </div>
  </section>

  <!-- 7 · close -->
  <section class="band close" id="start">
    <div class="site-wrap">
      <div class="close-grid">
        <div>
          <p class="kicker">start a study</p>
          <h2>send the project. get a fixed quote in one business day.</h2>
          <ol class="next">
            <li><span>01</span><span>send the drawings you have, your product data and the performance question.</span></li>
            <li><span>02</span><span>josé reviews the scope and replies within one business day with a fixed price and a schedule. <span class="caps-in">NDA</span> first, on request.</span></li>
            <li><span>03</span><span>your checked, client-ready report arrives, typically in 5 business days.</span></li>
          </ol>
          <div class="replier">
            <img src="/jose.jpg" alt="josé barría" width="1500" height="1500" loading="lazy" />
            <p>a direct reply from josé barría.<br /><span>no commitment · fixed-fee quotes</span></p>
          </div>
          <ul class="direct">
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          </ul>
        </div>

        <div class="form-col">
          <div class="sent" id="study-sent" hidden tabindex="-1">
            <p class="kicker">received</p>
            <h3>thanks. josé will review your project and reply within one business day.</h3>
          </div>

          <form class="study-form" action={FORMSPREE_ENDPOINT} method="POST" data-ajax data-sent="study-sent" data-lead-type="manufacturer">
            <div class="field">
              <label for="m-name">name</label>
              <input id="m-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="m-company">company</label>
              <input id="m-company" name="company" type="text" required autocomplete="organization" />
            </div>
            <div class="field full">
              <label for="m-email">work email</label>
              <input id="m-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field full">
              <label for="m-project">project and performance question</label>
              <textarea id="m-project" name="project" rows="4" required placeholder="city or climate, product specs, and what the design team or owner needs to see"></textarea>
            </div>
            <div class="field full">
              <label for="m-files">link to drawings <span class="opt">(optional)</span></label>
              <input id="m-files" name="files" type="url" placeholder="https://" />
            </div>

            <input type="hidden" name="_subject" value="entropica-lab.com · manufacturer study request" />
            <div class="honeypot" aria-hidden="true">
              <label>do not fill this field</label>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <p class="form-error" data-form-error hidden role="alert">
              the message didn't go through. write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>

            <button type="submit" class="btn amber">send for quote <span class="arrow-tail" aria-hidden="true"></span></button>
          </form>
        </div>
      </div>
    </div>
  </section>

<a class="sticky-cta" href="#start" data-sticky hidden>start a study <span aria-hidden="true">→</span></a>

  <StudyFooter slot="footer" overflowLink="/en/modeling-support/" />
</BaseLayout>

<script>
  import '../../scripts/ajax-form';

  // the sticky button shows once the hero is gone, and hides at the form.
  const sticky = document.querySelector<HTMLElement>('[data-sticky]');
  const hero = document.getElementById('hero');
  const start = document.getElementById('start');
  if (sticky && hero && start && 'IntersectionObserver' in window) {
    let heroOn = true;
    let startOn = false;
    const update = () => { sticky.hidden = heroOn || startOn; };
    new IntersectionObserver(([e]) => { heroOn = e.isIntersecting; update(); }).observe(hero);
    new IntersectionObserver(([e]) => { startOn = e.isIntersecting; update(); }, { threshold: 0.15 }).observe(start);
  }
</script>


